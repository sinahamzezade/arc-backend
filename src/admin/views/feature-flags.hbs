<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}} · Arlo Admin</title>
    {{> layout}}
    <style>
      .flag-row {
        display: grid;
        grid-template-columns: 1fr minmax(200px, 320px);
        gap: 1.25rem;
        align-items: start;
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid #e4ebe6;
        transition: background 140ms ease;
      }
      .flag-row:last-child { border-bottom: none; }
      .flag-row:hover { background: rgba(243, 246, 242, 0.55); }
      .flag-control label.flag-toggle {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        margin: 0;
        padding: 0.65rem 0.9rem;
        border-radius: 1rem;
        background: #f3f6f2;
        font-size: 0.875rem;
        font-weight: 600;
        letter-spacing: 0;
        text-transform: none;
        color: #1a2e28;
        cursor: pointer;
      }
      .flag-control select {
        width: 100%;
        margin: 0;
        padding: 11px 14px;
        border: 1px solid #d5ddd7;
        border-radius: 1rem;
        background: #fffefa;
        color: #1a2e28;
        font: inherit;
        font-size: 0.9rem;
        box-sizing: border-box;
      }
      .flag-control select:focus {
        outline: none;
        border-color: #5b7c6e;
        background: #fff;
      }
      .flag-multi {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.45rem;
        margin: 0;
        padding: 0.75rem;
        border-radius: 1rem;
        background: #f3f6f2;
      }
      .flag-multi label {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        margin: 0;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0;
        text-transform: none;
        color: #1a2e28;
        cursor: pointer;
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
      @media (max-width: 720px) {
        .flag-row {
          grid-template-columns: 1fr;
          gap: 0.85rem;
        }
      }
    </style>
  </head>
  <body class="bg-mist text-moss font-sans antialiased">
    <div class="shell min-h-screen">
      {{> shell-sidebar}}
      <main class="relative flex-1 min-w-0 overflow-x-hidden">
        <div
          class="pointer-events-none absolute -right-20 top-8 h-64 w-64 rounded-full bg-leaf/70 blur-3xl"
          aria-hidden="true"
        ></div>
        <div
          class="pointer-events-none absolute left-1/3 top-72 h-48 w-48 rounded-full bg-clay/12 blur-3xl"
          aria-hidden="true"
        ></div>

        <div class="relative px-5 pb-20 pt-6 md:px-10 lg:px-12">
          {{#if flashOk}}
            <p class="mb-5 rounded-2xl bg-leaf px-4 py-3 text-sm font-medium text-moss" role="status">{{flashOk}}</p>
          {{/if}}
          {{#if flashErr}}
            <p class="mb-5 rounded-2xl bg-[#fde8e6] px-4 py-3 text-sm font-medium text-coral" role="alert">{{flashErr}}</p>
          {{/if}}

          <section class="relative mb-10 md:mb-12">
            <div
              class="relative overflow-hidden rounded-blob bg-gradient-to-br from-moss via-[#243f36] to-[#314f44] px-7 py-9 text-mist shadow-soft md:w-[82%] md:px-10 md:py-11"
            >
              <div class="absolute -left-8 bottom-0 h-36 w-36 rounded-full bg-leaf/20 blur-2xl" aria-hidden="true"></div>
              <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-leaf/80">Runtime</p>
              <h1 class="font-display max-w-[14ch] text-4xl font-semibold leading-[1.05] tracking-tight md:text-5xl lg:text-6xl">
                Feature flags
              </h1>
              <p class="mt-4 max-w-md text-sm text-mist/60">
                Runtime toggles and LLM model picks — changes apply within about 10 seconds.
              </p>
              <div class="mt-6 flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center gap-2 rounded-full bg-leaf/90 px-3 py-1 text-xs font-semibold text-moss">
                  <i class="fa-solid fa-flag" aria-hidden="true"></i>
                  Live config
                </span>
              </div>
            </div>

            <aside
              class="relative z-10 mt-4 rounded-blob border border-[#d5ddd7] bg-foam/95 p-5 shadow-lift backdrop-blur md:absolute md:-bottom-6 md:right-0 md:mt-0 md:w-[260px]"
            >
              <div class="mb-2 flex items-center gap-2">
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-leaf text-moss">
                  <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                </span>
                <h2 class="font-display text-lg font-semibold">How it works</h2>
              </div>
              <p class="text-sm leading-relaxed text-sage">
                Flip a boolean or pick a model, then save. Services refresh from the latest values automatically.
              </p>
            </aside>
          </section>

          <form method="post" action="/admin/feature-flags" class="md:w-[94%] md:max-w-5xl">
            <div class="overflow-hidden rounded-blob bg-foam shadow-lift ring-1 ring-[#d5ddd7]">
              <div class="border-b border-[#e4ebe6] bg-[#eef3ef] px-5 py-3">
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-sage">Flags</p>
              </div>
              {{#each flags}}
                <div class="flag-row">
                  <div>
                    <p class="mb-1 font-mono text-[12px] text-sage">{{key}}</p>
                    <p class="mb-1.5 font-display text-lg font-semibold leading-snug">{{label}}</p>
                    {{#if description}}
                      <p class="m-0 text-sm leading-relaxed text-sage">{{description}}</p>
                    {{/if}}
                  </div>
                  <div class="flag-control">
                    {{#if isBoolean}}
                      <input type="hidden" name="{{key}}" value="false" />
                      <label class="flag-toggle">
                        <input
                          type="checkbox"
                          name="{{key}}"
                          value="true"
                          {{#if boolOn}}checked{{/if}}
                          class="h-4 w-4 accent-[#5b7c6e]"
                        />
                        Enabled
                      </label>
                    {{else if isMultiSelect}}
                      <input type="hidden" name="{{key}}" value="" />
                      <div class="flag-multi" role="group" aria-label="{{label}}">
                        {{#each options}}
                          <label>
                            <input
                              type="checkbox"
                              name="{{../key}}"
                              value="{{value}}"
                              {{#if selected}}checked{{/if}}
                              class="h-3.5 w-3.5 accent-[#5b7c6e]"
                            />
                            {{label}}
                          </label>
                        {{/each}}
                      </div>
                    {{else}}
                      <label for="flag-{{key}}" class="sr-only">{{label}}</label>
                      <select id="flag-{{key}}" name="{{key}}">
                        {{#each options}}
                          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                        {{/each}}
                      </select>
                    {{/if}}
                    <p class="mt-2 text-[11px] text-sage/80">Updated {{updatedAt}}</p>
                  </div>
                </div>
              {{/each}}
            </div>

            <div class="mt-6 flex flex-wrap items-center gap-3">
              {{> ui-button label="Save flags" icon="fa-solid fa-floppy-disk" }}
            </div>
          </form>
        </div>
      </main>
    </div>
  </body>
</html>
