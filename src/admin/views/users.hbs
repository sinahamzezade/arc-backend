<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}} · Arlo Admin</title>
    {{> layout}}
  </head>
  <body class="bg-mist text-moss font-sans antialiased">
    <div class="shell min-h-screen">
      {{> shell-sidebar}}
      <main class="relative flex-1 min-w-0 overflow-x-hidden">
        <div
          class="pointer-events-none absolute -right-20 top-8 h-64 w-64 rounded-full bg-leaf/70 blur-3xl"
          aria-hidden="true"
        ></div>
        <div
          class="pointer-events-none absolute left-1/3 top-72 h-48 w-48 rounded-full bg-clay/12 blur-3xl"
          aria-hidden="true"
        ></div>

        <div class="relative px-5 pb-20 pt-6 md:px-10 lg:px-12">
          <section class="relative mb-10 md:mb-12">
            <div
              class="relative overflow-hidden rounded-blob bg-gradient-to-br from-moss via-[#243f36] to-[#314f44] px-7 py-9 text-mist shadow-soft md:w-[82%] md:px-10 md:py-11"
            >
              <div class="absolute -left-8 bottom-0 h-36 w-36 rounded-full bg-leaf/20 blur-2xl" aria-hidden="true"></div>
              <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-leaf/80">Directory</p>
              <h1 class="font-display max-w-[10ch] text-4xl font-semibold leading-[1.05] tracking-tight md:text-5xl lg:text-6xl">
                Users
              </h1>
              <p class="mt-4 max-w-md text-sm text-mist/60">
                Browse accounts, open a profile for suspend, wallet, and learning resets.
              </p>
              <div class="mt-6 flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center gap-2 rounded-full bg-leaf/90 px-3 py-1 text-xs font-semibold tabular-nums text-moss">
                  <i class="fa-solid fa-users" aria-hidden="true"></i>
                  {{userCount}} account{{#unless userCountSingular}}s{{/unless}}
                </span>
              </div>
            </div>
          </section>

          {{#if hasUsers}}
            <div class="overflow-hidden rounded-blob bg-foam shadow-lift ring-1 ring-[#d5ddd7] md:w-[94%] md:max-w-5xl">
              <div class="overflow-x-auto">
                <table class="admin-table w-full min-w-[720px] text-left text-sm">
                  <thead>
                    <tr>
                      <th>Email</th>
                      <th>Display name</th>
                      <th>Provider</th>
                      <th>Status</th>
                      <th>Role</th>
                      <th>Created</th>
                      <th>Last login</th>
                    </tr>
                  </thead>
                  <tbody>
                    {{#each users}}
                      <tr>
                        <td>
                          <a class="font-medium text-moss underline-offset-2 hover:underline" href="/admin/users/{{id}}">{{email}}</a>
                        </td>
                        <td>{{#if displayName}}{{displayName}}{{else}}—{{/if}}</td>
                        <td class="font-mono text-[12px] text-sage">{{authProvider}}</td>
                        <td>
                          {{#if isActive}}
                            <span class="inline-flex items-center gap-1.5 rounded-full bg-leaf px-2.5 py-0.5 text-[11px] font-semibold text-moss">
                              <i class="fa-solid fa-circle-check text-[10px]" aria-hidden="true"></i>
                              Active
                            </span>
                          {{else}}
                            <span class="inline-flex items-center gap-1.5 rounded-full bg-mist px-2.5 py-0.5 text-[11px] font-semibold text-sage">
                              Suspended
                            </span>
                          {{/if}}
                        </td>
                        <td>
                          {{#if isAdmin}}
                            <span class="inline-flex items-center gap-1.5 rounded-full bg-leaf px-2.5 py-0.5 text-[11px] font-semibold text-moss">
                              <i class="fa-solid fa-shield-halved text-[10px]" aria-hidden="true"></i>
                              Admin
                            </span>
                          {{else}}
                            <span class="inline-flex items-center gap-1.5 rounded-full bg-mist px-2.5 py-0.5 text-[11px] font-semibold text-sage">
                              User
                            </span>
                          {{/if}}
                        </td>
                        <td class="font-mono text-[12px] text-sage">{{createdAt}}</td>
                        <td class="font-mono text-[12px] text-sage">{{#if lastLoginAt}}{{lastLoginAt}}{{else}}—{{/if}}</td>
                      </tr>
                    {{/each}}
                  </tbody>
                </table>
              </div>
            </div>
          {{else}}
            <div class="rounded-blob bg-foam px-6 py-14 text-center shadow-lift ring-1 ring-[#d5ddd7] md:w-[94%] md:max-w-5xl">
              <span class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-leaf text-moss">
                <i class="fa-solid fa-users" aria-hidden="true"></i>
              </span>
              <p class="font-display text-xl font-semibold">No users yet</p>
              <p class="mt-2 text-sm text-sage">Accounts will show here once people sign up.</p>
            </div>
          {{/if}}
        </div>
      </main>
    </div>
  </body>
</html>
