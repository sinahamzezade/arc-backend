<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}} · Arc Admin</title>
    {{> layout}}
  </head>
  <body class="bg-mist text-moss font-sans antialiased">
    <div class="shell min-h-screen">
      {{> shell-sidebar}}
      <main class="relative flex-1 min-w-0 overflow-x-hidden">
        <div
          class="pointer-events-none absolute -right-24 top-10 h-72 w-72 rounded-full bg-leaf/60 blur-3xl"
          aria-hidden="true"
        ></div>

        <div class="relative px-5 pb-24 pt-6 md:px-10 lg:px-12">
          <p class="mb-5 text-sm text-sage">
            <a href="/admin/goals" class="transition hover:text-moss">Goals</a>
            <span class="mx-2 opacity-40">/</span>
            <span class="font-mono text-[13px]">{{row.id}}</span>
          </p>

          {{#if flashOk}}
            <p class="mb-5 rounded-2xl bg-leaf px-4 py-3 text-sm font-medium text-moss" role="status">{{flashOk}}</p>
          {{/if}}
          {{#if flashErr}}
            <p class="mb-5 rounded-2xl bg-[#fde8e6] px-4 py-3 text-sm font-medium text-coral" role="alert">{{flashErr}}</p>
          {{/if}}

          <section class="relative mb-10 md:mb-12">
            <div
              class="relative overflow-hidden rounded-blob bg-gradient-to-br from-moss via-[#243f36] to-[#314f44] px-7 py-9 text-mist shadow-soft md:w-[85%] md:px-10 md:py-11"
            >
              <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-leaf/80">Learner goal</p>
              <h1 class="font-display text-3xl font-semibold leading-[1.1] tracking-tight md:text-4xl">
                {{row.userEmail}}
              </h1>
              <p class="mt-3 font-mono text-xs text-mist/55">{{row.userId}}</p>
              <div class="mt-6 flex flex-wrap gap-2">
                <span class="inline-flex items-center gap-2 rounded-full bg-leaf/90 px-3 py-1 text-xs font-semibold text-moss">
                  {{row.rolesLabel}}
                </span>
                <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold capitalize text-mist/85">
                  {{row.status}}
                </span>
              </div>
            </div>
          </section>

          <form
            method="post"
            action="/admin/goals/{{row.id}}"
            class="space-y-6 rounded-blob bg-foam p-6 shadow-lift ring-1 ring-[#d5ddd7] md:w-[94%] md:max-w-2xl"
          >
            <div>
              <h2 class="font-display text-2xl font-semibold">Edit goal</h2>
              <p class="mt-1 text-sm text-sage">
                Roadmap gen picks the recipe for the first matching <code>target_roles</code> slug.
              </p>
            </div>

            <div class="admin-field">
              <label for="targetRoles">Target roles (comma-separated domain slugs)</label>
              <input
                id="targetRoles"
                name="targetRoles"
                type="text"
                required
                value="{{rolesCsv}}"
                placeholder="crypto-trading"
              />
              {{#if hasDomains}}
                <p class="mt-2 text-xs text-sage">
                  Available:
                  {{#each domains}}
                    <button
                      type="button"
                      class="mx-0.5 rounded bg-leaf/50 px-1.5 py-0.5 font-mono text-[11px] text-moss hover:bg-leaf"
                      data-set-role="{{value}}"
                    >{{value}}</button>
                  {{/each}}
                </p>
              {{/if}}
            </div>

            <div class="admin-field">
              <label for="status">Status</label>
              <select id="status" name="status">
                {{#each statusOptions}}
                  <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <div class="admin-field">
                <label for="weeklyHours">Weekly hours</label>
                <input id="weeklyHours" name="weeklyHours" type="text" value="{{row.weeklyHours}}" placeholder="5-8" />
              </div>
              <div class="admin-field">
                <label for="targetDeadline">Target deadline</label>
                <input id="targetDeadline" name="targetDeadline" type="text" value="{{row.targetDeadline}}" placeholder="3-months" />
              </div>
            </div>

            <div class="admin-field">
              <label for="confidence">Confidence</label>
              <input id="confidence" name="confidence" type="text" value="{{row.confidence}}" placeholder="medium" />
            </div>

            <div class="flex flex-wrap gap-3 pt-2">
              <button
                type="submit"
                class="rounded-full bg-moss px-6 py-2.5 text-sm font-semibold text-mist transition hover:brightness-110"
              >
                Save goal
              </button>
              <a
                href="/admin/users/{{row.userId}}"
                class="rounded-full border border-leaf bg-leaf/40 px-5 py-2.5 text-sm font-semibold text-moss transition hover:bg-leaf"
              >
                Open user
              </a>
            </div>
          </form>
        </div>
      </main>
    </div>
    <script>
      document.querySelectorAll('[data-set-role]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const input = document.getElementById('targetRoles');
          if (input) input.value = btn.getAttribute('data-set-role') || '';
        });
      });
    </script>
  </body>
</html>
