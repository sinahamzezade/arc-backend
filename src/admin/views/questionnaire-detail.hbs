<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}} · Arc Admin</title>
    {{> layout}}
  </head>
  <body class="bg-mist text-moss font-sans antialiased">
    <div class="shell min-h-screen">
      {{> shell-sidebar}}
      <main class="relative flex-1 min-w-0 overflow-x-hidden">
        <div
          class="pointer-events-none absolute -right-24 top-10 h-72 w-72 rounded-full bg-leaf/60 blur-3xl"
          aria-hidden="true"
        ></div>

        <div class="relative px-5 pb-24 pt-6 md:px-10 lg:px-12">
          <p class="mb-5 text-sm text-sage">
            <a href="/admin/questionnaire" class="transition hover:text-moss">Questionnaire</a>
            <span class="mx-2 opacity-40">/</span>
            <span class="font-mono text-[13px]">v{{row.version}}</span>
          </p>

          {{#if flashOk}}
            <p class="mb-5 rounded-2xl bg-leaf px-4 py-3 text-sm font-medium text-moss" role="status">{{flashOk}}</p>
          {{/if}}
          {{#if flashErr}}
            <p class="mb-5 rounded-2xl bg-[#fde8e6] px-4 py-3 text-sm font-medium text-coral" role="alert">{{flashErr}}</p>
          {{/if}}

          <section class="relative mb-10 md:mb-12">
            <div
              class="relative overflow-hidden rounded-blob bg-gradient-to-br from-moss via-[#243f36] to-[#314f44] px-7 py-9 text-mist shadow-soft md:w-[85%] md:px-10 md:py-11"
            >
              <div class="absolute -right-6 top-4 h-28 w-28 rotate-12 rounded-[1.5rem] border border-white/10" aria-hidden="true"></div>
              <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-leaf/80">Schema version</p>
              <h1 class="font-display max-w-[12ch] text-4xl font-semibold leading-[1.05] tracking-tight md:text-5xl">
                Version {{row.version}}
              </h1>
              <div class="mt-6 flex flex-wrap gap-2">
                {{#if row.isActive}}
                  <span class="inline-flex items-center gap-2 rounded-full bg-leaf/90 px-3 py-1 text-xs font-semibold text-moss">
                    <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                    Active schema
                  </span>
                {{else}}
                  <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-mist/85">
                    Inactive schema
                  </span>
                {{/if}}
                <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold tabular-nums text-mist/85">
                  <i class="fa-solid fa-list-ol" aria-hidden="true"></i>
                  {{stepCount}} step{{#unless stepCountSingular}}s{{/unless}}
                </span>
              </div>
              {{#unless row.isActive}}
                <form method="post" action="/admin/questionnaire/{{row.id}}/activate" class="mt-6">
                  {{> ui-button label="Activate this version" icon="fa-solid fa-bolt" }}
                </form>
              {{/unless}}
            </div>

            <aside
              class="relative z-10 mt-4 rounded-blob border border-[#d5ddd7] bg-foam/95 p-5 shadow-lift backdrop-blur md:absolute md:-bottom-6 md:right-0 md:mt-0 md:w-[260px]"
            >
              <div class="mb-2 flex items-center gap-2">
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-leaf text-moss">
                  <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
                </span>
                <h2 class="font-display text-lg font-semibold">Steps</h2>
              </div>
              <p class="mb-4 text-sm leading-relaxed text-sage">
                Browse the step list or append a new field to this version.
              </p>
              <button
                type="button"
                class="flex w-full items-center justify-center gap-2 rounded-full bg-moss px-4 py-2.5 text-sm font-semibold text-mist transition hover:brightness-110"
                data-jump="create"
              >
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
                Add step
              </button>
            </aside>
          </section>

          <div class="admin-tabs md:w-[94%] md:max-w-5xl" data-admin-tabs data-default="catalog" data-err-tab="create">
            <div class="mb-6 flex gap-0 overflow-x-auto" role="tablist" aria-label="Version sections">
              <button type="button" role="tab" id="tab-catalog" aria-controls="panel-catalog" aria-selected="true" data-tab="catalog" class="shrink-0">
                <i class="fa-solid fa-list mr-1.5 text-xs opacity-70" aria-hidden="true"></i>
                Steps
              </button>
              <button type="button" role="tab" id="tab-create" aria-controls="panel-create" aria-selected="false" data-tab="create" class="shrink-0">
                <i class="fa-solid fa-plus mr-1.5 text-xs opacity-70" aria-hidden="true"></i>
                Add step
              </button>
            </div>

            <div id="panel-catalog" role="tabpanel" aria-labelledby="tab-catalog" data-panel="catalog" class="admin-panel">
              {{#if hasSteps}}
                <div class="overflow-hidden rounded-blob bg-foam shadow-lift ring-1 ring-[#d5ddd7]">
                  <div class="overflow-x-auto">
                    <table class="admin-table">
                      <thead>
                        <tr>
                          <th>#</th>
                          <th>Field</th>
                          <th>Title</th>
                          <th>UI</th>
                          <th>Selection</th>
                          <th>Options</th>
                          <th></th>
                        </tr>
                      </thead>
                      <tbody>
                        {{#each steps}}
                          <tr>
                            <td class="font-mono text-[13px] text-sage">{{stepNumber}}</td>
                            <td class="font-mono text-[13px]">{{fieldKey}}</td>
                            <td class="font-medium">{{title}}</td>
                            <td class="font-mono text-[12px] text-sage">{{uiKind}}</td>
                            <td class="font-mono text-[12px] text-sage">{{selection}}</td>
                            <td class="font-mono text-[12px] text-sage">{{optionCount}}</td>
                            <td>
                              <a class="text-sm font-semibold text-moss underline-offset-2 hover:underline" href="/admin/questionnaire/{{../row.id}}/steps/{{id}}">Edit</a>
                            </td>
                          </tr>
                        {{/each}}
                      </tbody>
                    </table>
                  </div>
                </div>
              {{else}}
                <div class="rounded-blob bg-foam px-6 py-14 text-center shadow-lift ring-1 ring-[#d5ddd7]">
                  <span class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-leaf text-moss">
                    <i class="fa-solid fa-list-ol" aria-hidden="true"></i>
                  </span>
                  <p class="font-display text-xl font-semibold">No steps on this definition</p>
                  <p class="mt-2 text-sm text-sage">Add a field from the Add step tab.</p>
                  <button
                    type="button"
                    class="mt-5 inline-flex items-center gap-2 rounded-full bg-moss px-5 py-2.5 text-sm font-semibold text-mist transition hover:brightness-110"
                    data-jump="create"
                  >
                    <i class="fa-solid fa-plus" aria-hidden="true"></i>
                    Create first step
                  </button>
                </div>
              {{/if}}
            </div>

            <div id="panel-create" role="tabpanel" aria-labelledby="tab-create" data-panel="create" class="admin-panel hidden" hidden>
              <div class="mb-5 md:ml-2 md:max-w-xl">
                <h2 class="font-display text-2xl font-semibold">Add step</h2>
                <p class="mt-1 text-sm text-sage">
                  Field key becomes the answer payload key. Options are edited on the step page.
                </p>
              </div>

              <form method="post" action="/admin/questionnaire/{{row.id}}/steps" class="space-y-6 md:ml-2">
                <div class="rounded-blob bg-foam p-5 shadow-lift ring-1 ring-[#d5ddd7]">
                  <div class="mb-4 flex items-center gap-2">
                    <span class="flex h-8 w-8 items-center justify-center rounded-full bg-leaf text-moss">
                      <i class="fa-solid fa-sliders" aria-hidden="true"></i>
                    </span>
                    <h3 class="font-display text-lg font-semibold">Step fields</h3>
                  </div>
                  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div class="admin-field">
                      <label for="fieldKey">Field key</label>
                      <input id="fieldKey" name="fieldKey" type="text" required placeholder="e.g. budget" />
                    </div>
                    <div class="admin-field">
                      <label for="title">Title</label>
                      <input id="title" name="title" type="text" required placeholder="Question text" />
                    </div>
                    <div class="admin-field sm:col-span-2">
                      <label for="subtitle">Subtitle</label>
                      <input id="subtitle" name="subtitle" type="text" placeholder="Optional helper" />
                    </div>
                    <div class="admin-field">
                      <label for="stepNumber">Step # (optional)</label>
                      <input id="stepNumber" name="stepNumber" type="number" min="1" />
                    </div>
                    <div class="admin-field">
                      <label for="selection">Selection</label>
                      <select id="selection" name="selection">
                        <option value="multi">multi</option>
                        <option value="single">single</option>
                      </select>
                    </div>
                    <div class="admin-field">
                      <label for="uiKind">UI kind</label>
                      <select id="uiKind" name="uiKind">
                        <option value="options">options</option>
                        <option value="schedule">schedule</option>
                      </select>
                    </div>
                    <div class="admin-field">
                      <label for="reviewLabel">Review label</label>
                      <input id="reviewLabel" name="reviewLabel" type="text" />
                    </div>
                    <div class="admin-field">
                      <label for="reviewIcon">Review icon</label>
                      <input id="reviewIcon" name="reviewIcon" type="text" value="target" />
                    </div>
                  </div>
                  <label class="mt-4 flex cursor-pointer items-center gap-3 rounded-2xl bg-mist/70 px-4 py-3 text-sm">
                    <input name="allowOther" type="checkbox" value="1" class="h-4 w-4 accent-[#5b7c6e]" />
                    <span class="font-semibold text-moss">Allow other</span>
                  </label>
                </div>

                <div class="flex flex-wrap items-center gap-3">
                  {{> ui-button label="Create step" icon="fa-solid fa-plus" }}
                </div>
              </form>
            </div>
          </div>
        </div>
      </main>
    </div>
    {{> admin-tabs-script}}
  </body>
</html>
