<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}} · Arc Admin</title>
    {{> layout}}
  </head>
  <body>
    <div class="shell">
      {{> shell-sidebar}}
      <main class="main">
        <p class="crumb"><a class="link" href="/admin/questionnaire">Questionnaire</a> / v{{row.version}}</p>
        {{#if flashOk}}<p class="flash flash-ok">{{flashOk}}</p>{{/if}}
        {{#if flashErr}}<p class="flash flash-err">{{flashErr}}</p>{{/if}}
        <div class="page-head">
          <h1>Version {{row.version}}</h1>
          <p class="sub">
            {{#if row.isActive}}Active schema{{else}}Inactive schema{{/if}}
            · {{stepCount}} step{{#unless stepCountSingular}}s{{/unless}}
          </p>
        </div>
        {{#unless row.isActive}}
          <form method="post" action="/admin/questionnaire/{{row.id}}/activate" style="margin-bottom:16px">
            {{> ui-button label="Activate this version" }}
          </form>
        {{/unless}}
        <div class="panel">
          {{#if hasSteps}}
            <div class="table-wrap">
              <table class="data">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Field</th>
                    <th>Title</th>
                    <th>UI</th>
                    <th>Selection</th>
                    <th>Options</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  {{#each steps}}
                    <tr>
                      <td class="mono">{{stepNumber}}</td>
                      <td class="mono">{{fieldKey}}</td>
                      <td>{{title}}</td>
                      <td class="mono">{{uiKind}}</td>
                      <td class="mono">{{selection}}</td>
                      <td class="mono">{{optionCount}}</td>
                      <td><a class="link" href="/admin/questionnaire/{{../row.id}}/steps/{{id}}">Edit</a></td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          {{else}}
            <div class="empty">No steps on this definition.</div>
          {{/if}}
        </div>

        <div class="panel" style="margin-top:16px">
          <h2 style="margin:0 0 12px;font-size:1rem">Add step</h2>
          <form method="post" action="/admin/questionnaire/{{row.id}}/steps">
            <div class="form-grid">
              <div>
                <label for="fieldKey">Field key</label>
                <input id="fieldKey" name="fieldKey" type="text" required placeholder="e.g. budget" />
              </div>
              <div>
                <label for="title">Title</label>
                <input id="title" name="title" type="text" required placeholder="Question text" />
              </div>
              <div>
                <label for="subtitle">Subtitle</label>
                <input id="subtitle" name="subtitle" type="text" placeholder="Optional helper" />
              </div>
              <div>
                <label for="stepNumber">Step # (optional)</label>
                <input id="stepNumber" name="stepNumber" type="number" min="1" />
              </div>
              <div>
                <label for="selection">Selection</label>
                <select id="selection" name="selection">
                  <option value="multi">multi</option>
                  <option value="single">single</option>
                </select>
              </div>
              <div>
                <label for="uiKind">UI kind</label>
                <select id="uiKind" name="uiKind">
                  <option value="options">options</option>
                  <option value="schedule">schedule</option>
                </select>
              </div>
              <div>
                <label for="reviewLabel">Review label</label>
                <input id="reviewLabel" name="reviewLabel" type="text" />
              </div>
              <div>
                <label for="reviewIcon">Review icon</label>
                <input id="reviewIcon" name="reviewIcon" type="text" value="target" />
              </div>
              <div>
                <label><input type="checkbox" name="allowOther" value="1" /> Allow other</label>
              </div>
            </div>
            <div class="form-actions">
              {{> ui-button label="Create step" }}
            </div>
          </form>
        </div>
      </main>
    </div>
  </body>
</html>
