<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}} · Arc Admin</title>
    {{> layout}}
  </head>
  <body class="bg-mist text-moss font-sans antialiased">
    <div class="shell min-h-screen">
      {{> shell-sidebar}}
      <main class="relative flex-1 min-w-0 overflow-x-hidden">
        <div
          class="pointer-events-none absolute -right-24 top-10 h-72 w-72 rounded-full bg-leaf/60 blur-3xl"
          aria-hidden="true"
        ></div>

        <div class="relative px-5 pb-24 pt-6 md:px-10 lg:px-12">
          <p class="mb-5 text-sm text-sage">
            <a href="/admin/questionnaire/{{defId}}" class="transition hover:text-moss">Questionnaire</a>
            <span class="mx-2 opacity-40">/</span>
            <a href="/admin/questionnaire/{{defId}}/steps/{{stepId}}" class="transition hover:text-moss">{{stepFieldKey}}</a>
            <span class="mx-2 opacity-40">/</span>
            <span class="font-mono text-[13px]">{{row.value}}</span>
          </p>

          {{#if flashOk}}
            <p class="mb-5 rounded-2xl bg-leaf px-4 py-3 text-sm font-medium text-moss" role="status">{{flashOk}}</p>
          {{/if}}
          {{#if flashErr}}
            <p class="mb-5 rounded-2xl bg-[#fde8e6] px-4 py-3 text-sm font-medium text-coral" role="alert">{{flashErr}}</p>
          {{/if}}

          <section class="relative mb-10 md:mb-12">
            <div
              class="relative overflow-hidden rounded-blob bg-gradient-to-br from-moss via-[#243f36] to-[#314f44] px-7 py-9 text-mist shadow-soft md:w-[85%] md:px-10 md:py-11"
            >
              <div class="absolute -right-6 top-4 h-28 w-28 rotate-12 rounded-[1.5rem] border border-white/10" aria-hidden="true"></div>
              <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-leaf/80">Step option</p>
              <h1 class="font-display max-w-[16ch] text-4xl font-semibold leading-[1.05] tracking-tight text-balance md:text-5xl">
                {{row.label}}
              </h1>
              <p class="mt-3 font-mono text-sm text-mist/50">{{row.value}}</p>
              <div class="mt-6 flex flex-wrap gap-2">
                <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-mist/85">
                  <i class="fa-solid fa-sort" aria-hidden="true"></i>
                  Order {{row.sortOrder}}
                </span>
                {{#if row.icon}}
                  <span class="inline-flex items-center gap-2 rounded-full bg-clay/90 px-3 py-1 text-xs font-semibold text-foam">
                    <i class="fa-solid fa-icons" aria-hidden="true"></i>
                    {{row.icon}}
                  </span>
                {{/if}}
              </div>
            </div>
          </section>

          <div class="admin-tabs md:w-[94%] md:max-w-5xl" data-admin-tabs data-default="edit" data-err-tab="edit">
            <div class="mb-6 flex gap-0 overflow-x-auto" role="tablist" aria-label="Option editor sections">
              <button type="button" role="tab" id="tab-edit" aria-controls="panel-edit" aria-selected="true" data-tab="edit" class="shrink-0">
                <i class="fa-solid fa-pen mr-1.5 text-xs opacity-70" aria-hidden="true"></i>
                Edit
              </button>
              <button type="button" role="tab" id="tab-danger" aria-controls="panel-danger" aria-selected="false" data-tab="danger" class="shrink-0">
                <i class="fa-solid fa-trash mr-1.5 text-xs opacity-70" aria-hidden="true"></i>
                Delete
              </button>
            </div>

            <div id="panel-edit" role="tabpanel" aria-labelledby="tab-edit" data-panel="edit" class="admin-panel">
              <div class="mb-5 md:ml-2 md:max-w-lg">
                <h2 class="font-display text-2xl font-semibold">Edit option</h2>
                <p class="mt-1 text-sm text-sage">Label, slug, icon, and sort order for this answer.</p>
              </div>

              <form method="post" action="/admin/questionnaire/{{defId}}/steps/{{stepId}}/options/{{row.id}}" class="space-y-6 md:ml-2">
                <div class="rounded-blob bg-foam p-5 shadow-lift ring-1 ring-[#d5ddd7]">
                  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div class="admin-field">
                      <label for="label">Label</label>
                      <input id="label" name="label" type="text" value="{{row.label}}" required />
                    </div>
                    <div class="admin-field">
                      <label for="value">Value / slug</label>
                      <input id="value" name="value" type="text" value="{{row.value}}" required />
                    </div>
                    <div class="admin-field">
                      {{> ui-icon-select}}
                    </div>
                    <div class="admin-field">
                      <label for="sortOrder">Sort order</label>
                      <input id="sortOrder" name="sortOrder" type="number" value="{{row.sortOrder}}" required />
                    </div>
                    <div class="admin-field sm:col-span-2">
                      <label for="profileSignalJson">Profile signal (JSON object)</label>
                      <textarea id="profileSignalJson" name="profileSignalJson" rows="8" spellcheck="false">{{row.profileSignalJson}}</textarea>
                      <p class="mt-2 text-xs leading-relaxed text-sage">
                        Private scoring metadata. Only a string <span class="font-mono">hint</span> is exposed to clients.
                      </p>
                    </div>
                  </div>
                </div>

                <div class="flex flex-wrap items-center gap-3">
                  {{> ui-button label="Save option" icon="fa-solid fa-floppy-disk" }}
                  {{> ui-button label="Back" href=backHref variant="secondary" }}
                </div>
              </form>
            </div>

            <div id="panel-danger" role="tabpanel" aria-labelledby="tab-danger" data-panel="danger" class="admin-panel hidden" hidden>
              <div class="rounded-blob bg-foam p-5 shadow-lift ring-1 ring-[#d5ddd7] md:ml-2 md:max-w-lg">
                <div class="mb-4 flex items-center gap-2">
                  <span class="flex h-8 w-8 items-center justify-center rounded-full bg-[#fde8e6] text-coral">
                    <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                  </span>
                  <h3 class="font-display text-lg font-semibold">Delete option</h3>
                </div>
                <p class="mb-5 text-sm text-sage">
                  Removes this answer from the step. This cannot be undone.
                </p>
                <form method="post" action="/admin/questionnaire/{{defId}}/steps/{{stepId}}/options/{{row.id}}/delete" onsubmit="return confirm('Delete this option?');">
                  {{> ui-button label="Delete option" variant="danger" icon="fa-solid fa-trash" }}
                </form>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
    {{> admin-tabs-script}}
  </body>
</html>
