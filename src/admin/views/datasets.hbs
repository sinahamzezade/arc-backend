<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}} · Arc Admin</title>
    {{> layout}}
  </head>
  <body>
    <div class="shell">
      {{> shell-sidebar}}
      <main class="main">
        <div class="page-head">
          <h1>Datasets</h1>
          <p class="sub">{{count}} dataset{{#unless countSingular}}s{{/unless}}</p>
        </div>
        {{#if flashOk}}<p class="flash flash-ok">{{flashOk}}</p>{{/if}}
        {{#if flashErr}}<p class="flash flash-err">{{flashErr}}</p>{{/if}}

        <h2 class="section-title">Add dataset</h2>
        <div class="panel" style="margin-bottom:18px">
          <form method="post" action="/admin/datasets">
            <div class="form-grid">
              <div>
                <label for="slug">Slug</label>
                <input id="slug" name="slug" type="text" required />
              </div>
              <div>
                <label for="title">Title</label>
                <input id="title" name="title" type="text" required />
              </div>
              <div>
                <label for="storageKey">Storage key</label>
                <input id="storageKey" name="storageKey" type="text" placeholder="s3://bucket/path.csv" required />
              </div>
              <div>
                <label for="checksum">Checksum</label>
                <input id="checksum" name="checksum" type="text" placeholder="sha256:…" required />
              </div>
              <div>
                <label for="format">Format</label>
                <input id="format" name="format" type="text" value="csv" />
              </div>
            </div>
            <div class="form-actions">
              <button type="submit">Create dataset</button>
            </div>
          </form>
        </div>

        <div class="panel">
          {{#if hasRows}}
            <div class="table-wrap">
              <table class="data">
                <thead>
                  <tr>
                    <th>Slug</th>
                    <th>Title</th>
                    <th>Format</th>
                    <th>Storage</th>
                    <th>Active</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each rows}}
                    <tr>
                      <td class="mono">{{slug}}</td>
                      <td>{{title}}</td>
                      <td class="mono">{{format}}</td>
                      <td class="mono">{{storageKey}}</td>
                      <td>
                        {{#if isActive}}
                          <span class="badge badge-ok">Yes</span>
                        {{else}}
                          <span class="badge badge-off">No</span>
                        {{/if}}
                      </td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          {{else}}
            <div class="empty">No datasets yet.</div>
          {{/if}}
        </div>
      </main>
    </div>
  </body>
</html>
