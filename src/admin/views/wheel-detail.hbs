<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}} · Arlo Admin</title>
    {{> layout}}
  </head>
  <body class="bg-mist text-moss font-sans antialiased">
    <div class="shell min-h-screen">
      {{> shell-sidebar}}
      <main class="relative flex-1 min-w-0 overflow-x-hidden">
        <div
          class="pointer-events-none absolute -right-24 top-10 h-72 w-72 rounded-full bg-leaf/60 blur-3xl"
          aria-hidden="true"
        ></div>

        <div class="relative px-5 pb-24 pt-6 md:px-10 lg:px-12">
          <p class="mb-5 text-sm text-sage">
            <a href="/admin/wheel" class="transition hover:text-moss">Lucky Wheel</a>
            <span class="mx-2 opacity-40">/</span>
            <span class="font-mono text-[13px]">{{campaign.slug}}</span>
          </p>

          {{#if flashOk}}
            <p class="mb-5 rounded-2xl bg-leaf px-4 py-3 text-sm font-medium text-moss" role="status">{{flashOk}}</p>
          {{/if}}
          {{#if flashErr}}
            <p class="mb-5 rounded-2xl bg-[#fde8e6] px-4 py-3 text-sm font-medium text-coral" role="alert">{{flashErr}}</p>
          {{/if}}

          <section class="relative mb-10 md:mb-12">
            <div
              class="relative overflow-hidden rounded-blob bg-gradient-to-br from-moss via-[#243f36] to-[#314f44] px-7 py-9 text-mist shadow-soft md:w-[85%] md:px-10 md:py-11"
            >
              <div class="absolute -right-6 top-4 h-28 w-28 rotate-12 rounded-[1.5rem] border border-white/10" aria-hidden="true"></div>
              <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-leaf/80">Wheel campaign</p>
              <h1 class="font-display max-w-[16ch] text-4xl font-semibold leading-[1.05] tracking-tight text-balance md:text-5xl">
                {{campaign.slug}}
              </h1>
              <p class="mt-3 text-sm text-mist/55">Campaign settings + segment rules</p>
              <div class="mt-6 flex flex-wrap gap-2">
                <span class="inline-flex items-center gap-2 rounded-full bg-leaf/90 px-3 py-1 text-xs font-semibold text-moss">
                  <i class="fa-solid fa-circle-nodes" aria-hidden="true"></i>
                  {{campaign.segmentCount}} segments
                </span>
                <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-mist/85">
                  <i class="fa-solid fa-rotate" aria-hidden="true"></i>
                  {{campaign.maxFreeSpinsPerDay}} free / day
                </span>
              </div>
            </div>
          </section>

          <div
            class="admin-tabs md:w-[94%] md:max-w-5xl"
            data-admin-tabs
            data-default="settings"
            data-err-tab="settings"
          >
            <div class="mb-6 flex gap-0 overflow-x-auto" role="tablist" aria-label="Wheel campaign sections">
              <button type="button" role="tab" id="tab-settings" aria-controls="panel-settings" aria-selected="true" data-tab="settings" class="shrink-0">
                <i class="fa-solid fa-sliders mr-1.5 text-xs opacity-70" aria-hidden="true"></i>
                Settings
              </button>
              <button type="button" role="tab" id="tab-segments" aria-controls="panel-segments" aria-selected="false" data-tab="segments" class="shrink-0">
                <i class="fa-solid fa-chart-pie mr-1.5 text-xs opacity-70" aria-hidden="true"></i>
                Segments
              </button>
            </div>

            {{!-- Settings --}}
            <div id="panel-settings" role="tabpanel" aria-labelledby="tab-settings" data-panel="settings" class="admin-panel">
              <div class="mb-4 md:ml-2 md:max-w-lg">
                <h2 class="font-display text-2xl font-semibold">Campaign settings</h2>
                <p class="mt-1 text-sm text-sage">Status, spin limits, respin price, and segment count.</p>
              </div>

              <form method="post" action="/admin/wheel/{{campaign.id}}" class="md:ml-2">
                <div class="rounded-blob bg-foam p-5 shadow-lift ring-1 ring-[#d5ddd7]">
                  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div class="admin-field">
                      <label for="status">Status</label>
                      <select id="status" name="status">
                        {{#each statuses}}
                          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                        {{/each}}
                      </select>
                    </div>
                    <div class="admin-field">
                      <label for="maxFreeSpinsPerDay">Free spins / day</label>
                      <input id="maxFreeSpinsPerDay" name="maxFreeSpinsPerDay" type="number" min="0" value="{{campaign.maxFreeSpinsPerDay}}" />
                    </div>
                    <div class="admin-field">
                      <label for="maxPaidRespinsPerDay">Paid respins / day</label>
                      <input id="maxPaidRespinsPerDay" name="maxPaidRespinsPerDay" type="number" min="0" value="{{campaign.maxPaidRespinsPerDay}}" />
                    </div>
                    <div class="admin-field">
                      <label for="respinGemPrice">Respin gem price</label>
                      <input id="respinGemPrice" name="respinGemPrice" type="number" min="0" value="{{campaign.respinGemPrice}}" />
                    </div>
                    <div class="admin-field sm:col-span-2">
                      <label for="segmentCount">Segment count</label>
                      <input id="segmentCount" name="segmentCount" type="number" min="1" value="{{campaign.segmentCount}}" />
                    </div>
                  </div>
                </div>

                <div class="mt-6 flex flex-wrap items-center gap-3">
                  {{> ui-button label="Save campaign" icon="fa-solid fa-floppy-disk" }}
                  <a href="/admin/wheel" class="text-sm font-semibold text-sage transition hover:text-moss">Back to catalog</a>
                </div>
              </form>
            </div>

            {{!-- Segments --}}
            <div id="panel-segments" role="tabpanel" aria-labelledby="tab-segments" data-panel="segments" class="admin-panel hidden" hidden>
              <div class="mb-4 md:ml-2 md:max-w-lg">
                <h2 class="font-display text-2xl font-semibold">Segments</h2>
                <p class="mt-1 text-sm text-sage">Weight, sort order, and active flag per reward key.</p>
              </div>

              {{#if hasSegments}}
                <div class="overflow-hidden rounded-blob bg-foam shadow-lift ring-1 ring-[#d5ddd7] md:ml-2">
                  <div class="overflow-x-auto">
                    <table class="admin-table">
                      <thead>
                        <tr>
                          <th>Key</th>
                          <th>Type</th>
                          <th>Weight</th>
                          <th>Order</th>
                          <th>Active</th>
                          <th></th>
                        </tr>
                      </thead>
                      <tbody>
                        {{#each segments}}
                          <tr>
                            <td class="font-mono text-[12px] font-medium">{{rewardKey}}</td>
                            <td class="font-mono text-[12px] text-sage">{{rewardType}}</td>
                            <td colspan="4">
                              <form
                                method="post"
                                action="/admin/wheel/segments/{{id}}"
                                class="flex flex-wrap items-center gap-2"
                              >
                                <input
                                  name="weight"
                                  type="text"
                                  value="{{weight}}"
                                  class="m-0 w-[88px] rounded-2xl border border-[#d5ddd7] bg-[#fffefa] px-3 py-2 font-mono text-sm text-moss"
                                />
                                <input
                                  name="sortOrder"
                                  type="number"
                                  value="{{sortOrder}}"
                                  class="m-0 w-[72px] rounded-2xl border border-[#d5ddd7] bg-[#fffefa] px-3 py-2 font-mono text-sm text-moss"
                                />
                                <label class="flex cursor-pointer items-center gap-2 rounded-2xl bg-mist/70 px-3 py-2 text-sm">
                                  <input name="isActive" type="checkbox" value="1" class="h-4 w-4 accent-[#5b7c6e]" {{#if isActive}}checked{{/if}} />
                                  <span class="font-semibold text-moss">On</span>
                                </label>
                                {{> ui-button label="Update" variant="secondary" size="sm" }}
                              </form>
                            </td>
                          </tr>
                        {{/each}}
                      </tbody>
                    </table>
                  </div>
                </div>
              {{else}}
                <div class="rounded-blob bg-foam px-6 py-14 text-center shadow-lift ring-1 ring-[#d5ddd7] md:ml-2">
                  <span class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-leaf text-moss">
                    <i class="fa-solid fa-chart-pie" aria-hidden="true"></i>
                  </span>
                  <p class="font-display text-xl font-semibold">No segment rules</p>
                  <p class="mt-2 text-sm text-sage">Segments appear when the campaign is configured.</p>
                </div>
              {{/if}}
            </div>
          </div>
        </div>
      </main>
    </div>

    {{> admin-tabs-script}}
  </body>
</html>
