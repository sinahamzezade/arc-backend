<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}} · Arc Admin</title>
    {{> layout}}
  </head>
  <body>
    <div class="shell">
      {{> shell-sidebar}}
      <main class="main">
        <div class="page-head">
          <h1>Ranks</h1>
          <p class="sub">{{count}} definition{{#unless countSingular}}s{{/unless}}</p>
        </div>
        <div class="panel">
          {{#if hasRows}}
            <div class="table-wrap">
              <table class="data">
                <thead>
                  <tr>
                    <th>Level</th>
                    <th>Title</th>
                    <th>Slug</th>
                    <th>XP</th>
                    <th>Active days</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each rows}}
                    <tr>
                      <td class="mono">{{level}}</td>
                      <td><a class="link" href="/admin/ranks/{{id}}">{{title}}</a></td>
                      <td class="mono">{{slug}}</td>
                      <td class="mono">{{xpThreshold}}</td>
                      <td class="mono">{{minimumActiveDays}}</td>
                      <td>
                        {{#if isActive}}
                          <span class="badge badge-ok">Active</span>
                        {{else}}
                          <span class="badge badge-off">Off</span>
                        {{/if}}
                      </td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          {{else}}
            <div class="empty">No ranks seeded yet.</div>
          {{/if}}
        </div>
      </main>
    </div>
  </body>
</html>
