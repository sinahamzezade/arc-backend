<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}} · Arlo Admin</title>
    {{> layout}}
  </head>
  <body class="bg-mist text-moss font-sans antialiased">
    <div class="shell min-h-screen">
      {{> shell-sidebar}}
      <main class="relative flex-1 min-w-0 overflow-x-hidden">
        <div class="relative px-5 pb-20 pt-6 md:px-10 lg:px-12">
          {{#if flashOk}}
            <p class="mb-5 rounded-2xl bg-leaf px-4 py-3 text-sm font-medium text-moss" role="status">{{flashOk}}</p>
          {{/if}}
          {{#if flashErr}}
            <p class="mb-5 rounded-2xl bg-[#fde8e6] px-4 py-3 text-sm font-medium text-coral" role="alert">{{flashErr}}</p>
          {{/if}}

          <section class="relative mb-10">
            <div class="relative overflow-hidden rounded-blob bg-gradient-to-br from-moss via-[#243f36] to-[#314f44] px-7 py-9 text-mist shadow-soft md:w-[82%] md:px-10 md:py-11">
              <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-leaf/80">Content pool</p>
              <h1 class="font-display max-w-[14ch] text-4xl font-semibold leading-[1.05] tracking-tight md:text-5xl">
                Units
              </h1>
              <p class="mt-4 max-w-lg text-sm text-mist/60">
                Flattened curriculum. Import a units JSON (skills_index + units) to add a whole course at runtime — no redeploy.
              </p>
              <div class="mt-6 flex flex-wrap gap-2">
                <span class="inline-flex items-center gap-2 rounded-full bg-leaf/90 px-3 py-1 text-xs font-semibold text-moss">
                  {{unitCount}} unit{{#unless unitCountSingular}}s{{/unless}}
                </span>
                <span class="inline-flex items-center gap-2 rounded-full bg-mist/15 px-3 py-1 text-xs font-semibold text-mist">
                  {{skillCount}} skill{{#unless skillCountSingular}}s{{/unless}}
                </span>
              </div>
            </div>
          </section>

          <div class="admin-tabs md:max-w-5xl" data-admin-tabs data-default="catalog" data-err-tab="import">
            <div class="mb-6 flex gap-0 overflow-x-auto" role="tablist" aria-label="Units sections">
              <button type="button" role="tab" id="tab-catalog" aria-controls="panel-catalog" aria-selected="true" data-tab="catalog" class="shrink-0">
                Catalog
              </button>
              <button type="button" role="tab" id="tab-import" aria-controls="panel-import" aria-selected="false" data-tab="import" class="shrink-0">
                Import JSON
              </button>
              <button type="button" role="tab" id="tab-skills" aria-controls="panel-skills" aria-selected="false" data-tab="skills" class="shrink-0">
                Skills index
              </button>
              <button type="button" role="tab" id="tab-guide" aria-controls="panel-guide" aria-selected="false" data-tab="guide" class="shrink-0">
                <i class="fa-regular fa-circle-question mr-1.5 text-xs opacity-70" aria-hidden="true"></i>
                Guide
              </button>
            </div>

            <div id="panel-catalog" role="tabpanel" aria-labelledby="tab-catalog" data-panel="catalog">
              <form
                method="post"
                action="/admin/units/bulk-remove"
                data-bulk-remove
                onsubmit="return window.confirm('Permanently delete the selected units? This cannot be undone.')"
              >
                <div class="mb-4 flex flex-wrap items-center gap-3">
                  <label class="inline-flex cursor-pointer items-center gap-2 text-sm text-moss">
                    <input type="checkbox" data-bulk-all aria-label="Select all units" class="h-4 w-4 accent-fern" />
                    Select all
                  </label>
                  <p class="mr-auto text-sm text-sage" data-bulk-count>No units selected</p>
                  <button
                    type="submit"
                    disabled
                    data-bulk-submit
                    class="cursor-pointer rounded-full bg-coral px-5 py-2.5 text-sm font-semibold text-white transition disabled:cursor-not-allowed disabled:opacity-40"
                  >
                    Delete selected
                  </button>
                </div>

                {{#if unitGroups.length}}
                  <div class="space-y-5">
                    {{#each unitGroups}}
                      <section class="overflow-hidden rounded-blob border border-[#d5ddd7] bg-foam/95 shadow-lift" data-unit-group="{{stack}}">
                        <div class="flex flex-wrap items-center gap-3 border-b border-[#d5ddd7] bg-mist/40 px-4 py-3">
                          <label class="inline-flex cursor-pointer items-center gap-2">
                            <input
                              type="checkbox"
                              data-bulk-group
                              aria-label="Select all {{stack}} units"
                              class="h-4 w-4 accent-fern"
                            />
                            <span class="font-display text-base font-semibold text-moss">{{stack}}</span>
                          </label>
                          <span class="rounded-full bg-leaf/70 px-2.5 py-0.5 text-xs font-semibold text-moss">
                            {{count}} unit{{#unless countSingular}}s{{/unless}}
                          </span>
                          <p class="ml-auto text-xs text-sage">Click a unit to select · open for edit</p>
                        </div>
                        <ul class="divide-y divide-[#e8eee9]" role="list">
                          {{#each units}}
                            <li>
                              <div
                                class="group flex cursor-pointer items-stretch gap-3 px-4 py-3 transition hover:bg-mist/50 data-[selected=true]:bg-leaf/40"
                                data-unit-item
                                data-selected="false"
                              >
                                <input
                                  type="checkbox"
                                  name="ids"
                                  value="{{id}}"
                                  data-bulk-row
                                  aria-label="Select {{title}}"
                                  class="mt-1 h-4 w-4 shrink-0 cursor-pointer accent-fern"
                                />
                                <div class="min-w-0 flex-1">
                                  <p class="truncate font-medium text-moss">{{title}}</p>
                                  <p class="mt-0.5 truncate font-mono text-[11px] text-sage">{{id}}</p>
                                  <div class="mt-2 flex flex-wrap gap-1.5 text-[11px]">
                                    <span class="rounded-full bg-mist px-2 py-0.5 font-semibold text-moss">{{lessonType}}</span>
                                    <span class="rounded-full bg-mist px-2 py-0.5 tabular-nums text-sage">L{{level}}</span>
                                    <span class="rounded-full bg-mist px-2 py-0.5 tabular-nums text-sage">{{estimatedMinutes}}m</span>
                                    <span class="rounded-full bg-mist px-2 py-0.5 tabular-nums text-sage">{{xp}} XP</span>
                                  </div>
                                </div>
                                <a
                                  href="/admin/units/{{id}}"
                                  data-unit-open
                                  class="shrink-0 self-center rounded-full border border-moss/20 px-3 py-1.5 text-xs font-semibold text-moss transition hover:bg-leaf/60"
                                >
                                  Open
                                </a>
                              </div>
                            </li>
                          {{/each}}
                        </ul>
                      </section>
                    {{/each}}
                  </div>
                {{else}}
                  <div class="rounded-blob border border-[#d5ddd7] bg-foam/95 px-4 py-10 text-center text-sm text-sage shadow-lift">
                    No units yet. Import a JSON package.
                  </div>
                {{/if}}
              </form>
            </div>

            <div id="panel-import" role="tabpanel" aria-labelledby="tab-import" data-panel="import" hidden>
              <div class="mb-4 flex flex-wrap items-center gap-3 rounded-blob border border-[#d5ddd7] bg-foam/95 p-4 shadow-lift">
                <p class="mr-auto text-sm text-sage">Not sure about the format? Grab a template or export the current pool.</p>
                <a
                  href="/admin/units/example.json"
                  download
                  class="inline-flex items-center gap-2 rounded-full border border-moss/25 px-4 py-2 text-sm font-semibold text-moss transition hover:bg-leaf/60"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path d="M10 3a1 1 0 0 1 1 1v6.586l1.793-1.793a1 1 0 1 1 1.414 1.414l-3.5 3.5a1 1 0 0 1-1.414 0l-3.5-3.5a1 1 0 1 1 1.414-1.414L9 10.586V4a1 1 0 0 1 1-1Z"/><path d="M4 14a1 1 0 0 1 1 1v1h10v-1a1 1 0 1 1 2 0v2a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-2a1 1 0 0 1 1-1Z"/></svg>
                  Download example JSON
                </a>
                <a
                  href="/admin/units/export.json"
                  download
                  class="inline-flex items-center gap-2 rounded-full border border-moss/25 px-4 py-2 text-sm font-semibold text-moss transition hover:bg-leaf/60"
                >
                  Export current pool
                </a>
              </div>
              <form method="post" action="/admin/units/import" class="rounded-blob border border-[#d5ddd7] bg-foam/95 p-6 shadow-lift space-y-4">
                <div class="flex flex-wrap items-center gap-3 rounded-2xl border border-dashed border-[#c3cec6] bg-mist/40 px-4 py-3">
                  <label
                    for="units-json-file"
                    class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-moss/25 bg-foam px-4 py-2 text-sm font-semibold text-moss transition hover:bg-leaf/60"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path d="M10 17a1 1 0 0 1-1-1V9.414l-1.793 1.793a1 1 0 1 1-1.414-1.414l3.5-3.5a1 1 0 0 1 1.414 0l3.5 3.5a1 1 0 1 1-1.414 1.414L11 9.414V16a1 1 0 0 1-1 1Z"/><path d="M4 3a1 1 0 0 1 1-1h10a1 1 0 1 1 0 2H5a1 1 0 0 1-1-1Z"/></svg>
                    Choose JSON file
                  </label>
                  <input type="file" id="units-json-file" accept=".json,application/json" class="sr-only" data-import-file />
                  <p class="text-sm text-sage" data-import-file-status>No file chosen — contents fill the box below.</p>
                </div>
                <label class="block text-sm font-semibold">
                  Units JSON
                  <textarea
                    name="payload"
                    rows="16"
                    required
                    class="mt-2 w-full rounded-2xl border border-[#d5ddd7] bg-mist/40 px-4 py-3 font-mono text-xs"
                    placeholder='{"skills_index":[...],"units":[...]}'
                  >{{samplePayload}}</textarea>
                </label>
                <label class="flex items-center gap-2 text-sm">
                  <input type="checkbox" name="deactivateMissing" value="true" />
                  Deactivate skills/units missing from this file
                </label>
                <button type="submit" class="rounded-full bg-moss px-5 py-2.5 text-sm font-semibold text-mist">
                  Import package
                </button>
              </form>
            </div>

            <div id="panel-skills" role="tabpanel" aria-labelledby="tab-skills" data-panel="skills" hidden>
              <div class="overflow-hidden rounded-blob border border-[#d5ddd7] bg-foam/95 shadow-lift">
                <table class="w-full text-left text-sm">
                  <thead class="border-b border-[#d5ddd7] bg-mist/40 text-xs uppercase tracking-wide text-sage">
                    <tr>
                      <th class="px-4 py-3">Id</th>
                      <th class="px-4 py-3">Title</th>
                      <th class="px-4 py-3">Level</th>
                      <th class="px-4 py-3">Prerequisites</th>
                    </tr>
                  </thead>
                  <tbody>
                    {{#each skills}}
                      <tr class="border-b border-[#e8eee9] last:border-0 transition hover:bg-mist/40">
                        <td class="px-4 py-3 font-mono text-[12px]">
                          <a href="/admin/units/skills/{{id}}" class="underline decoration-leaf underline-offset-2 hover:text-fern">{{id}}</a>
                        </td>
                        <td class="px-4 py-3 font-medium">
                          <a href="/admin/units/skills/{{id}}" class="hover:text-fern">{{title}}</a>
                        </td>
                        <td class="px-4 py-3 tabular-nums">{{level}}</td>
                        <td class="px-4 py-3 font-mono text-[11px] text-sage">{{prerequisitesLabel}}</td>
                      </tr>
                    {{else}}
                      <tr>
                        <td colspan="4" class="px-4 py-8 text-center text-sage">No skills yet.</td>
                      </tr>
                    {{/each}}
                  </tbody>
                </table>
              </div>
            </div>

            <div id="panel-guide" role="tabpanel" aria-labelledby="tab-guide" data-panel="guide" hidden>
              <div class="space-y-6">
                <section class="relative overflow-hidden rounded-blob bg-moss px-6 py-7 text-mist shadow-lift md:px-8">
                  <div class="pointer-events-none absolute -right-12 -top-14 h-40 w-40 rounded-full bg-leaf/20 blur-3xl" aria-hidden="true"></div>
                  <p class="text-xs font-semibold uppercase tracking-[0.16em] text-leaf">Units tutorial</p>
                  <h2 class="font-display mt-2 text-3xl font-semibold">Publish a course in four steps</h2>
                  <p class="mt-3 max-w-2xl text-sm leading-relaxed text-mist/65">
                    One JSON package defines the skill graph and every playable lesson. Importing updates matching IDs and creates new ones without a redeploy.
                  </p>
                  <div class="mt-5 flex flex-wrap gap-3">
                    <a href="/admin/units/example.json" download class="inline-flex items-center gap-2 rounded-full bg-leaf px-4 py-2 text-sm font-semibold text-moss transition hover:bg-[#c8e0d1]">
                      <i class="fa-solid fa-download" aria-hidden="true"></i>
                      Download starter file
                    </a>
                    <button type="button" data-jump="import" class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-mist/25 px-4 py-2 text-sm font-semibold text-mist transition hover:bg-white/10">
                      <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                      Open importer
                    </button>
                  </div>
                </section>

                <section class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4" aria-label="Import steps">
                  <article class="rounded-blob border border-[#d5ddd7] bg-foam p-5 shadow-lift">
                    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-moss font-display text-sm font-semibold text-mist">1</span>
                    <h3 class="mt-4 font-display text-lg font-semibold">Define skills</h3>
                    <p class="mt-1.5 text-sm leading-relaxed text-sage">Add stable IDs to <code>skills_index</code>. Prerequisites must reference another skill ID.</p>
                  </article>
                  <article class="rounded-blob border border-[#d5ddd7] bg-foam p-5 shadow-lift">
                    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-moss font-display text-sm font-semibold text-mist">2</span>
                    <h3 class="mt-4 font-display text-lg font-semibold">Author units</h3>
                    <p class="mt-1.5 text-sm leading-relaxed text-sage">Choose lesson type, stage, role, duration, reward, and type-specific content.</p>
                  </article>
                  <article class="rounded-blob border border-[#d5ddd7] bg-foam p-5 shadow-lift">
                    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-moss font-display text-sm font-semibold text-mist">3</span>
                    <h3 class="mt-4 font-display text-lg font-semibold">Validate</h3>
                    <p class="mt-1.5 text-sm leading-relaxed text-sage">Use unique IDs, resolve every prerequisite, and keep the skill graph cycle-free.</p>
                  </article>
                  <article class="rounded-blob border border-[#d5ddd7] bg-foam p-5 shadow-lift">
                    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-moss font-display text-sm font-semibold text-mist">4</span>
                    <h3 class="mt-4 font-display text-lg font-semibold">Import &amp; verify</h3>
                    <p class="mt-1.5 text-sm leading-relaxed text-sage">Upload the file, import it, then inspect Catalog and Skills index before generating paths.</p>
                  </article>
                </section>

                <section class="grid gap-6 lg:grid-cols-[1fr_1.15fr]">
                  <div class="rounded-blob border border-[#d5ddd7] bg-foam p-6 shadow-lift">
                    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-fern">Package anatomy</p>
                    <h3 class="font-display mt-2 text-2xl font-semibold">Required fields</h3>
                    <div class="mt-5 space-y-4 text-sm">
                      <div>
                        <p class="font-semibold text-moss"><code>skills_index[]</code></p>
                        <p class="mt-1 text-sage"><code>id</code>, <code>title</code>, <code>prerequisites[]</code>, <code>level</code></p>
                      </div>
                      <div class="border-t border-[#e1e8e2] pt-4">
                        <p class="font-semibold text-moss"><code>units[]</code></p>
                        <p class="mt-1 leading-relaxed text-sage">
                          <code>id</code>, <code>title</code>, <code>skills_taught[]</code>, <code>prerequisites[]</code>,
                          <code>level</code>, <code>estimated_minutes</code>, <code>formats[]</code>, <code>lesson_type</code>,
                          <code>domain</code>, <code>stack</code>, <code>xp</code>, <code>content</code>
                        </p>
                      </div>
                      <div class="border-t border-[#e1e8e2] pt-4">
                        <p class="font-semibold text-moss">Optional targeting</p>
                        <p class="mt-1 leading-relaxed text-sage">
                          <code>serves_stage[]</code>, <code>unit_role</code>, <code>profile_skill_slug</code>,
                          <code>provider</code>, <code>url</code>
                        </p>
                      </div>
                    </div>
                  </div>

                  <div class="overflow-hidden rounded-blob border border-[#d5ddd7] bg-[#172c25] shadow-lift">
                    <div class="flex items-center justify-between border-b border-white/10 px-5 py-3">
                      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-leaf">Minimal package</p>
                      <span class="rounded-full bg-white/10 px-2.5 py-1 font-mono text-[10px] text-mist/70">units.json</span>
                    </div>
                    <pre class="overflow-x-auto p-5 font-mono text-[11px] leading-relaxed text-mist/80"><code>{
  "skills_index": [{
    "id": "html-css:html-intro",
    "title": "HTML foundations",
    "prerequisites": [],
    "level": 1
  }],
  "units": [{
    "id": "html-intro-read",
    "title": "How HTML pages work",
    "skills_taught": ["html-css:html-intro"],
    "prerequisites": [],
    "level": 1,
    "estimated_minutes": 15,
    "formats": ["reading"],
    "lesson_type": "reading",
    "domain": "frontend",
    "stack": "html-css",
    "xp": 30,
    "serves_stage": [1, 2],
    "unit_role": "foundation",
    "content": {
      "objective": "Understand page structure",
      "sections": [{
        "id": "structure",
        "title": "Document structure",
        "blocks": [{
          "type": "text",
          "body": "HTML gives a page structure."
        }]
      }],
      "keyTakeaways": ["Structure comes before style"]
    }
  }]
}</code></pre>
                  </div>
                </section>

                <section class="rounded-blob border border-[#d5ddd7] bg-foam p-6 shadow-lift">
                  <p class="text-xs font-semibold uppercase tracking-[0.14em] text-fern">Content recipes</p>
                  <h3 class="font-display mt-2 text-2xl font-semibold">Shape content by lesson type</h3>
                  <div class="mt-5 grid gap-4 md:grid-cols-2">
                    <div class="rounded-2xl bg-mist/60 p-4">
                      <p class="font-semibold">Reading</p>
                      <p class="mt-1 text-sm text-sage"><code>objective</code>, <code>sections[]</code>, <code>keyTakeaways[]</code></p>
                      <p class="mt-2 text-xs leading-relaxed text-sage">Section blocks support <strong>text</strong> (<code>body</code>), <strong>callout</strong> (<code>title</code> + <code>body</code>), and <strong>code</strong> (<code>label</code> + <code>code</code>).</p>
                    </div>
                    <div class="rounded-2xl bg-mist/60 p-4">
                      <p class="font-semibold">Practice / project / interactive</p>
                      <p class="mt-1 text-sm text-sage"><code>objective</code>, <code>task</code>, <code>acceptanceCriteria[]</code></p>
                      <p class="mt-2 text-xs text-sage">Optional: <code>hints[]</code>, <code>starterHtml</code>.</p>
                    </div>
                    <div class="rounded-2xl bg-mist/60 p-4">
                      <p class="font-semibold">Quiz</p>
                      <p class="mt-1 text-sm text-sage"><code>objective</code>, <code>passScore</code>, <code>questions[]</code></p>
                      <p class="mt-2 text-xs leading-relaxed text-sage">Question types: <code>mcq</code> with options + numeric answer index, or <code>boolean</code> with a boolean answer.</p>
                    </div>
                    <div class="rounded-2xl bg-mist/60 p-4">
                      <p class="font-semibold">Video</p>
                      <p class="mt-1 text-sm text-sage"><code>objective</code>, <code>note</code></p>
                      <p class="mt-2 text-xs text-sage">Set unit-level <code>provider</code> and <code>url</code> for the external resource.</p>
                    </div>
                  </div>
                </section>

                <section class="grid gap-6 md:grid-cols-2">
                  <div class="rounded-blob border border-[#d5ddd7] bg-foam p-6 shadow-lift">
                    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-fern">Roles &amp; stages</p>
                    <h3 class="font-display mt-2 text-xl font-semibold">Control roadmap placement</h3>
                    <ul class="mt-4 space-y-2.5 text-sm text-sage">
                      <li><strong class="text-moss">foundation</strong> — teaches a new skill.</li>
                      <li><strong class="text-moss">refresher</strong> — restores prior knowledge.</li>
                      <li><strong class="text-moss">checkpoint</strong> — verifies stage evidence.</li>
                      <li><strong class="text-moss">project</strong> — applies several skills.</li>
                      <li><strong class="text-moss">proof</strong> — creates demonstrable evidence.</li>
                    </ul>
                    <p class="mt-4 rounded-2xl bg-leaf/60 px-4 py-3 text-xs leading-relaxed text-moss">
                      <code>serves_stage</code> accepts learner stages 1–5. Checkpoint and proof units are retained even when format preferences differ.
                    </p>
                  </div>

                  <div class="rounded-blob border border-[#d5ddd7] bg-foam p-6 shadow-lift">
                    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-coral">Before importing</p>
                    <h3 class="font-display mt-2 text-xl font-semibold">Safety checklist</h3>
                    <ul class="mt-4 space-y-3 text-sm text-sage">
                      <li class="flex gap-2"><i class="fa-solid fa-check mt-0.5 text-fern" aria-hidden="true"></i><span>Export the current pool as a backup.</span></li>
                      <li class="flex gap-2"><i class="fa-solid fa-check mt-0.5 text-fern" aria-hidden="true"></i><span>Keep IDs stable; matching IDs are updated.</span></li>
                      <li class="flex gap-2"><i class="fa-solid fa-check mt-0.5 text-fern" aria-hidden="true"></i><span>Ensure every prerequisite and taught skill exists.</span></li>
                      <li class="flex gap-2"><i class="fa-solid fa-check mt-0.5 text-fern" aria-hidden="true"></i><span>Use “deactivate missing” only for a complete replacement package.</span></li>
                      <li class="flex gap-2"><i class="fa-solid fa-check mt-0.5 text-fern" aria-hidden="true"></i><span>Existing roadmap lessons keep their saved content snapshots.</span></li>
                    </ul>
                  </div>
                </section>

                <section class="rounded-blob border border-[#ead7a0] bg-[#fffaf0] p-6 shadow-lift">
                  <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#9a6b18]">Troubleshooting</p>
                  <div class="mt-4 grid gap-4 text-sm md:grid-cols-3">
                    <div>
                      <p class="font-semibold text-moss">Invalid JSON</p>
                      <p class="mt-1 text-sage">Check commas, quotes, and closing brackets. File selector validates syntax before filling the editor.</p>
                    </div>
                    <div>
                      <p class="font-semibold text-moss">Graph validation failed</p>
                      <p class="mt-1 text-sage">A prerequisite is missing or creates a cycle. Add the skill or remove the circular dependency.</p>
                    </div>
                    <div>
                      <p class="font-semibold text-moss">Lesson content not ready</p>
                      <p class="mt-1 text-sage">Verify the unit has a valid type-specific <code>content</code> object and regenerate or reopen the lesson.</p>
                    </div>
                  </div>
                </section>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
    {{> admin-tabs-script}}
    <script>
      (function () {
        var form = document.querySelector('[data-bulk-remove]');
        if (!form) return;
        var all = form.querySelector('[data-bulk-all]');
        var rows = Array.prototype.slice.call(form.querySelectorAll('[data-bulk-row]'));
        var submit = form.querySelector('[data-bulk-submit]');
        var count = form.querySelector('[data-bulk-count]');
        var groups = Array.prototype.slice.call(form.querySelectorAll('[data-unit-group]'));

        function syncGroup(section) {
          var groupCb = section.querySelector('[data-bulk-group]');
          var groupRows = Array.prototype.slice.call(section.querySelectorAll('[data-bulk-row]'));
          if (!groupCb || !groupRows.length) return;
          var checked = groupRows.filter(function (r) { return r.checked; }).length;
          groupCb.checked = checked > 0 && checked === groupRows.length;
          groupCb.indeterminate = checked > 0 && checked < groupRows.length;
        }

        function sync() {
          var checked = rows.filter(function (r) { return r.checked; }).length;
          submit.disabled = checked === 0;
          count.textContent =
            checked === 0
              ? 'No units selected'
              : checked + ' unit' + (checked === 1 ? '' : 's') + ' selected';
          if (all) {
            all.checked = checked > 0 && checked === rows.length;
            all.indeterminate = checked > 0 && checked < rows.length;
          }
          form.querySelectorAll('[data-unit-item]').forEach(function (item) {
            var cb = item.querySelector('[data-bulk-row]');
            item.setAttribute('data-selected', cb && cb.checked ? 'true' : 'false');
          });
          groups.forEach(syncGroup);
        }

        if (all) {
          all.addEventListener('change', function () {
            rows.forEach(function (r) { r.checked = all.checked; });
            sync();
          });
        }

        groups.forEach(function (section) {
          var groupCb = section.querySelector('[data-bulk-group]');
          if (!groupCb) return;
          groupCb.addEventListener('change', function () {
            section.querySelectorAll('[data-bulk-row]').forEach(function (r) {
              r.checked = groupCb.checked;
            });
            sync();
          });
        });

        form.querySelectorAll('[data-unit-item]').forEach(function (item) {
          item.addEventListener('click', function (e) {
            if (e.target.closest('[data-unit-open]')) return;
            if (e.target.closest('input[type="checkbox"]')) return;
            var cb = item.querySelector('[data-bulk-row]');
            if (!cb) return;
            cb.checked = !cb.checked;
            sync();
          });
        });

        rows.forEach(function (r) { r.addEventListener('change', sync); });
        sync();
      })();

      (function () {
        var input = document.querySelector('[data-import-file]');
        if (!input) return;
        var status = document.querySelector('[data-import-file-status]');
        var textarea = document.querySelector('textarea[name="payload"]');

        input.addEventListener('change', function () {
          var file = input.files && input.files[0];
          if (!file) return;
          var reader = new FileReader();
          reader.onload = function () {
            var text = String(reader.result || '');
            try {
              JSON.parse(text);
            } catch (e) {
              status.textContent = file.name + ' is not valid JSON: ' + e.message;
              status.classList.add('text-coral');
              return;
            }
            textarea.value = text;
            status.textContent = 'Loaded ' + file.name + ' (' + Math.round(file.size / 1024) + ' KB). Review below, then import.';
            status.classList.remove('text-coral');
          };
          reader.onerror = function () {
            status.textContent = 'Could not read ' + file.name;
            status.classList.add('text-coral');
          };
          reader.readAsText(file);
        });
      })();
    </script>
  </body>
</html>
