<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}} · Arlo Admin</title>
    {{> layout}}
  </head>
  <body class="bg-mist text-moss font-sans antialiased">
    <div class="shell min-h-screen">
      {{> shell-sidebar}}
      <main class="relative flex-1 min-w-0 overflow-x-hidden">
        <div
          class="pointer-events-none absolute -right-24 top-10 h-72 w-72 rounded-full bg-leaf/70 blur-3xl"
          aria-hidden="true"
        ></div>
        <div class="relative px-5 pb-16 pt-6 md:px-10 lg:px-12">
          <div class="mb-6">
            <h1 class="font-display text-3xl font-semibold tracking-tight md:text-4xl">
              Dashboard
            </h1>
            <p class="mt-1 text-sm text-sage">
              Product analytics · signed in as {{email}}
            </p>
          </div>
          <div id="admin-dashboard-root"></div>
        </div>
      </main>
    </div>
    <link rel="stylesheet" href="/admin-assets/dashboard.css" />
    <script type="module" src="/admin-assets/dashboard.js"></script>
  </body>
</html>
