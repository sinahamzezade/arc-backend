<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}} · Arc Admin</title>
    {{> layout}}
  </head>
  <body class="bg-mist text-moss font-sans antialiased">
    <div class="shell min-h-screen">
      {{> shell-sidebar}}
      <main class="relative flex-1 min-w-0 overflow-x-hidden">
        <div
          class="pointer-events-none absolute -right-24 top-10 h-72 w-72 rounded-full bg-leaf/60 blur-3xl"
          aria-hidden="true"
        ></div>
        <div
          class="pointer-events-none absolute left-1/4 top-80 h-48 w-48 rounded-full bg-clay/12 blur-3xl"
          aria-hidden="true"
        ></div>

        <div class="relative px-5 pb-24 pt-6 md:px-10 lg:px-12">
          <p class="mb-5 text-sm text-sage">
            <a href="/admin/skill-graph" class="transition hover:text-moss">Skill graph</a>
            <span class="mx-2 opacity-40">/</span>
            <span class="font-mono text-[13px]">{{stack.slug}}</span>
          </p>

          {{#if flashOk}}
            <p class="mb-5 rounded-2xl bg-leaf px-4 py-3 text-sm font-medium text-moss" role="status">{{flashOk}}</p>
          {{/if}}
          {{#if flashErr}}
            <p class="mb-5 rounded-2xl bg-[#fde8e6] px-4 py-3 text-sm font-medium text-coral" role="alert">{{flashErr}}</p>
          {{/if}}

          <section class="relative mb-10 md:mb-12">
            <div
              class="relative overflow-hidden rounded-blob bg-gradient-to-br from-moss via-[#243f36] to-[#314f44] px-7 py-9 text-mist shadow-soft md:w-[85%] md:px-10 md:py-11"
            >
              <div class="absolute -right-6 top-4 h-28 w-28 rotate-12 rounded-[1.5rem] border border-white/10" aria-hidden="true"></div>
              <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-leaf/80">Tech stack</p>
              <h1 class="font-display max-w-[16ch] text-4xl font-semibold leading-[1.05] tracking-tight text-balance md:text-5xl">
                {{stack.name}}
              </h1>
              <p class="mt-3 font-mono text-sm text-mist/50">{{stack.slug}}</p>
              <div class="mt-6 flex flex-wrap gap-2">
                <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-mist/85">
                  <i class="fa-solid fa-folder" aria-hidden="true"></i>
                  {{stack.category}}
                </span>
                {{#if stack.isActive}}
                  <span class="inline-flex items-center gap-2 rounded-full bg-leaf/90 px-3 py-1 text-xs font-semibold text-moss">
                    <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                    Active
                  </span>
                {{else}}
                  <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-mist/80">
                    Off
                  </span>
                {{/if}}
              </div>
            </div>

            <aside
              class="relative z-10 mt-4 rounded-blob border border-[#d5ddd7] bg-foam/95 p-5 shadow-lift backdrop-blur md:absolute md:-bottom-6 md:right-0 md:mt-0 md:w-[260px]"
            >
              <div class="mb-2 flex items-center gap-2">
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-leaf text-moss">
                  <i class="fa-solid fa-sliders" aria-hidden="true"></i>
                </span>
                <h2 class="font-display text-lg font-semibold">Actions</h2>
              </div>
              <p class="mb-4 text-sm leading-relaxed text-sage">
                Edit stack fields, or jump to add a skill under this catalog node.
              </p>
              <div class="flex flex-col gap-2">
                <button
                  type="button"
                  class="flex w-full items-center justify-center gap-2 rounded-full bg-moss px-4 py-2.5 text-sm font-semibold text-mist transition hover:brightness-110"
                  data-jump="skills"
                >
                  <i class="fa-solid fa-plus" aria-hidden="true"></i>
                  Add skill
                </button>
                <button
                  type="button"
                  class="flex w-full items-center justify-center gap-2 rounded-full border border-leaf bg-leaf/40 px-4 py-2.5 text-sm font-semibold text-moss transition hover:bg-leaf"
                  data-jump="details"
                >
                  <i class="fa-solid fa-pen" aria-hidden="true"></i>
                  Edit details
                </button>
              </div>
            </aside>
          </section>

          <div
            class="admin-tabs md:w-[94%] md:max-w-5xl"
            data-admin-tabs
            data-default="details"
            data-err-tab="details"
          >
            <div class="mb-6 flex gap-0 overflow-x-auto" role="tablist" aria-label="Stack editor sections">
              <button type="button" role="tab" id="tab-details" aria-controls="panel-details" aria-selected="true" data-tab="details" class="shrink-0">
                <i class="fa-solid fa-id-card mr-1.5 text-xs opacity-70" aria-hidden="true"></i>
                Details
              </button>
              <button type="button" role="tab" id="tab-skills" aria-controls="panel-skills" aria-selected="false" data-tab="skills" class="shrink-0">
                <i class="fa-solid fa-diagram-project mr-1.5 text-xs opacity-70" aria-hidden="true"></i>
                Skills
              </button>
            </div>

            <div id="panel-details" role="tabpanel" aria-labelledby="tab-details" data-panel="details" class="admin-panel">
              <div class="mb-4 md:ml-2 md:max-w-lg">
                <h2 class="font-display text-2xl font-semibold">Stack details</h2>
                <p class="mt-1 text-sm text-sage">Name, category, description, and active flag.</p>
              </div>
              <form method="post" action="/admin/skill-graph/stacks/{{stack.id}}" class="md:ml-2 md:max-w-2xl">
                <div class="rounded-blob bg-foam p-5 shadow-lift ring-1 ring-[#d5ddd7]">
                  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div class="admin-field">
                      <label for="name">Name</label>
                      <input id="name" name="name" type="text" value="{{stack.name}}" required />
                    </div>
                    <div class="admin-field">
                      <label for="category">Category</label>
                      <input id="category" name="category" type="text" value="{{stack.category}}" />
                    </div>
                    <div class="admin-field sm:col-span-2">
                      <label for="description">Description</label>
                      <textarea id="description" name="description" rows="4">{{stack.description}}</textarea>
                    </div>
                  </div>
                  <label class="mt-4 flex cursor-pointer items-center gap-3 rounded-2xl bg-mist/70 px-4 py-3 text-sm">
                    <input id="isActive" name="isActive" type="checkbox" value="1" class="h-4 w-4 accent-[#5b7c6e]" {{#if stack.isActive}}checked{{/if}} />
                    <span>
                      <span class="font-semibold text-moss">Active</span>
                      <span class="mt-0.5 block text-xs text-sage">Inactive stacks stay hidden from learners.</span>
                    </span>
                  </label>
                  <div class="mt-5">
                    {{> ui-button label="Save stack" icon="fa-solid fa-floppy-disk" }}
                  </div>
                </div>
              </form>
            </div>

            <div id="panel-skills" role="tabpanel" aria-labelledby="tab-skills" data-panel="skills" class="admin-panel hidden" hidden>
              <div class="mb-5 md:ml-2 md:max-w-xl">
                <h2 class="font-display text-2xl font-semibold">Skills</h2>
                <p class="mt-1 text-sm text-sage">Add a skill to this stack, then manage the catalog below.</p>
              </div>

              <form method="post" action="/admin/skill-graph/stacks/{{stack.id}}/skills" class="mb-8 md:ml-2 md:max-w-3xl">
                <div class="rounded-blob bg-foam p-5 shadow-lift ring-1 ring-[#d5ddd7]">
                  <div class="mb-4 flex items-center gap-2">
                    <span class="flex h-8 w-8 items-center justify-center rounded-full bg-leaf text-moss">
                      <i class="fa-solid fa-plus" aria-hidden="true"></i>
                    </span>
                    <h3 class="font-display text-lg font-semibold">Add skill</h3>
                  </div>
                  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div class="admin-field">
                      <label for="skillTitle">Title</label>
                      <input id="skillTitle" name="title" type="text" placeholder="What Is the Web?" required />
                    </div>
                    <div class="admin-field">
                      <label for="skillSlug">Slug (optional)</label>
                      <input id="skillSlug" name="slug" type="text" placeholder="web-internet" />
                    </div>
                    <div class="admin-field">
                      <label for="orderHint">Order</label>
                      <input id="orderHint" name="orderHint" type="number" value="0" />
                    </div>
                    <div class="admin-field">
                      <label for="estimatedHours">Hours</label>
                      <input id="estimatedHours" name="estimatedHours" type="number" step="0.5" value="1" />
                    </div>
                    <div class="admin-field">
                      <label for="tags">Tags (comma)</label>
                      <input id="tags" name="tags" type="text" placeholder="html-css" />
                    </div>
                    <div class="admin-field">
                      <label for="prereqSlugs">Prereq slugs (comma)</label>
                      <input id="prereqSlugs" name="prereqSlugs" type="text" placeholder="web-internet" />
                    </div>
                    <div class="admin-field sm:col-span-2">
                      <label for="skillDescription">Description</label>
                      <textarea id="skillDescription" name="description" rows="3"></textarea>
                    </div>
                  </div>
                  <div class="mt-5">
                    {{> ui-button label="Create skill" icon="fa-solid fa-plus" }}
                  </div>
                </div>
              </form>

              <div class="md:ml-2">
                {{#if hasSkills}}
                  <div class="overflow-hidden rounded-blob bg-foam shadow-lift ring-1 ring-[#d5ddd7]">
                    <div class="overflow-x-auto">
                      <table class="admin-table">
                        <thead>
                          <tr>
                            <th>Order</th>
                            <th>Title</th>
                            <th>Slug</th>
                            <th>Hours</th>
                            <th>Lessons</th>
                            <th>Status</th>
                            <th></th>
                          </tr>
                        </thead>
                        <tbody>
                          {{#each skills}}
                            <tr>
                              <td class="font-mono text-[12px] text-sage">{{orderHint}}</td>
                              <td>
                                <a class="font-medium text-moss underline-offset-2 hover:underline" href="/admin/skill-graph/skills/{{id}}">{{title}}</a>
                              </td>
                              <td class="font-mono text-[12px] text-sage">{{slug}}</td>
                              <td class="font-mono text-[12px] text-sage">{{estimatedHours}}</td>
                              <td class="font-mono text-[12px] text-sage">{{lessonCount}}</td>
                              <td>
                                {{#if isActive}}
                                  <span class="inline-flex items-center gap-1.5 rounded-full bg-leaf px-2.5 py-0.5 text-[11px] font-semibold text-moss">
                                    <i class="fa-solid fa-circle-check text-[10px]" aria-hidden="true"></i>
                                    Active
                                  </span>
                                {{else}}
                                  <span class="inline-flex items-center gap-1.5 rounded-full bg-mist px-2.5 py-0.5 text-[11px] font-semibold text-sage">
                                    Off
                                  </span>
                                {{/if}}
                              </td>
                              <td>
                                <form method="post" action="/admin/skill-graph/skills/{{id}}/delete" class="m-0" onsubmit="return confirm('Delete skill {{title}} and its lessons?');">
                                  {{> ui-button label="Delete" variant="danger" size="sm" }}
                                </form>
                              </td>
                            </tr>
                          {{/each}}
                        </tbody>
                      </table>
                    </div>
                  </div>
                {{else}}
                  <div class="rounded-blob bg-foam px-6 py-12 text-center shadow-lift ring-1 ring-[#d5ddd7]">
                    <span class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-leaf text-moss">
                      <i class="fa-solid fa-diagram-project" aria-hidden="true"></i>
                    </span>
                    <p class="font-display text-xl font-semibold">No skills on this stack</p>
                    <p class="mt-2 text-sm text-sage">Use the form above to add the first skill.</p>
                  </div>
                {{/if}}
              </div>
            </div>
          </div>

          <section class="mt-12 md:ml-2 md:max-w-xl">
            <div class="mb-3 flex items-baseline justify-between gap-3">
              <h2 class="font-display text-xl font-semibold text-coral">Danger</h2>
              <span class="text-xs font-medium uppercase tracking-[0.14em] text-sage">Irreversible</span>
            </div>
            <div class="rounded-blob border border-[#f0c9c5] bg-[#fdf6f5] p-5">
              <p class="mb-4 text-sm leading-relaxed text-sage">
                Deletes this stack and all nested skills and lessons.
              </p>
              <form
                method="post"
                action="/admin/skill-graph/stacks/{{stack.id}}/delete"
                onsubmit="return confirm('Delete this stack and all skills/lessons?');"
              >
                {{> ui-button label="Delete stack" variant="danger" icon="fa-solid fa-trash" }}
              </form>
            </div>
          </section>
        </div>
      </main>
    </div>
    {{> admin-tabs-script}}
  </body>
</html>
