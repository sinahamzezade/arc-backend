<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}} · Arc Admin</title>
    {{> layout}}
  </head>
  <body>
    <div class="shell">
      {{> shell-sidebar}}
      <main class="main">
        <p class="crumb"><a class="link" href="/admin/skill-graph">Skill graph</a> / {{stack.slug}}</p>
        {{#if flashOk}}<p class="flash flash-ok">{{flashOk}}</p>{{/if}}
        {{#if flashErr}}<p class="flash flash-err">{{flashErr}}</p>{{/if}}
        <div class="page-head">
          <h1>{{stack.name}}</h1>
          <p class="sub">{{stack.slug}} · {{stack.category}}</p>
        </div>

        <div class="panel" style="margin-bottom:18px">
          <form method="post" action="/admin/skill-graph/stacks/{{stack.id}}">
            <div class="form-grid">
              <div>
                <label for="name">Name</label>
                <input id="name" name="name" type="text" value="{{stack.name}}" required />
              </div>
              <div>
                <label for="category">Category</label>
                <input id="category" name="category" type="text" value="{{stack.category}}" />
              </div>
              <div style="grid-column:1/-1">
                <label for="description">Description</label>
                <textarea id="description" name="description">{{stack.description}}</textarea>
              </div>
              <div class="check-row">
                <input id="isActive" name="isActive" type="checkbox" value="1" {{#if stack.isActive}}checked{{/if}} />
                <label for="isActive">Active</label>
              </div>
            </div>
            <div class="form-actions">
              {{> ui-button label="Save stack" icon="fa-solid fa-floppy-disk" }}
            </div>
          </form>
          <div class="form-actions" style="padding-top:0">
            <form method="post" action="/admin/skill-graph/stacks/{{stack.id}}/delete" style="margin:0" onsubmit="return confirm('Delete this stack and all skills/lessons?');">
              {{> ui-button label="Delete stack" variant="danger" icon="fa-solid fa-trash" }}
            </form>
          </div>
        </div>

        <h2 class="section-title">Add skill</h2>
        <div class="panel" style="margin-bottom:18px">
          <form method="post" action="/admin/skill-graph/stacks/{{stack.id}}/skills">
            <div class="form-grid">
              <div>
                <label for="skillTitle">Title</label>
                <input id="skillTitle" name="title" type="text" placeholder="What Is the Web?" required />
              </div>
              <div>
                <label for="skillSlug">Slug (optional)</label>
                <input id="skillSlug" name="slug" type="text" placeholder="web-internet" />
              </div>
              <div>
                <label for="orderHint">Order</label>
                <input id="orderHint" name="orderHint" type="number" value="0" />
              </div>
              <div>
                <label for="estimatedHours">Hours</label>
                <input id="estimatedHours" name="estimatedHours" type="number" step="0.5" value="1" />
              </div>
              <div>
                <label for="tags">Tags (comma)</label>
                <input id="tags" name="tags" type="text" placeholder="html-css" />
              </div>
              <div>
                <label for="prereqSlugs">Prereq slugs (comma)</label>
                <input id="prereqSlugs" name="prereqSlugs" type="text" placeholder="web-internet" />
              </div>
              <div style="grid-column:1/-1">
                <label for="skillDescription">Description</label>
                <textarea id="skillDescription" name="description"></textarea>
              </div>
            </div>
            <div class="form-actions">
              {{> ui-button label="Create skill" icon="fa-solid fa-plus" }}
            </div>
          </form>
        </div>

        <h2 class="section-title">Skills</h2>
        <div class="panel">
          {{#if hasSkills}}
            <div class="table-wrap">
              <table class="data">
                <thead>
                  <tr>
                    <th>Order</th>
                    <th>Title</th>
                    <th>Slug</th>
                    <th>Hours</th>
                    <th>Lessons</th>
                    <th>Status</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  {{#each skills}}
                    <tr>
                      <td class="mono">{{orderHint}}</td>
                      <td><a class="link" href="/admin/skill-graph/skills/{{id}}">{{title}}</a></td>
                      <td class="mono">{{slug}}</td>
                      <td class="mono">{{estimatedHours}}</td>
                      <td class="mono">{{lessonCount}}</td>
                      <td>
                        {{#if isActive}}
                          <span class="badge badge-ok">Active</span>
                        {{else}}
                          <span class="badge badge-off">Off</span>
                        {{/if}}
                      </td>
                      <td>
                        <form method="post" action="/admin/skill-graph/skills/{{id}}/delete" style="margin:0" onsubmit="return confirm('Delete skill {{title}} and its lessons?');">
                          {{> ui-button label="Delete" variant="danger" size="sm" }}
                        </form>
                      </td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          {{else}}
            <div class="empty">No skills on this stack.</div>
          {{/if}}
        </div>
      </main>
    </div>
  </body>
</html>
