    </a>
    <a href="/admin/quests" class="{{#if navQuests}}active{{/if}}">
      <span class="nav-icon"><i class="fa-solid fa-scroll" aria-hidden="true"></i></span>
      Quests
    </a>
    <a href="/admin/wheel" class="{{#if navWheel}}active{{/if}}">
      <span class="nav-icon"><i class="fa-solid fa-dharmachakra" aria-hidden="true"></i></span>
      Lucky Wheel
    </a>

    <p class="sidebar-label">Learning</p>
    <a href="/admin/units" class="{{#if navUnits}}active{{/if}}">
      <span class="nav-icon"><i class="fa-solid fa-cubes" aria-hidden="true"></i></span>
