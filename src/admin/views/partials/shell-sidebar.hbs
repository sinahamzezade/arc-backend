<aside class="sidebar">
  <div class="sidebar-brand">
    <span class="sidebar-logo" aria-hidden="true">
      <i class="fa-solid fa-seedling"></i>
    </span>
    <span class="sidebar-brand-text">
      Arc Admin
      <span>Ops console</span>
    </span>
  </div>
  <nav class="sidebar-nav" aria-label="Admin">
    <p class="sidebar-label">Overview</p>
    <a href="/admin" class="{{#if navDashboard}}active{{/if}}">
      <span class="nav-icon"><i class="fa-solid fa-border-all" aria-hidden="true"></i></span>
