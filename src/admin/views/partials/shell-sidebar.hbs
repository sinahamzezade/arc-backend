    </a>

    <p class="sidebar-label">Engagement</p>
    <a href="/admin/ranks" class="{{#if navRanks}}active{{/if}}">
      <span class="nav-icon"><i class="fa-solid fa-medal" aria-hidden="true"></i></span>
