{{!--
  Shared tab controller.
  Root: [data-admin-tabs]
  Optional attrs on root:
    data-default="catalog"     — initial tab id
    data-err-tab="create"      — open this tab when ?err= present
    data-ok-map='{"created":"catalog"}' — optional JSON ok→tab map
  Tabs: [role=tab][data-tab=id]
  Panels: [role=tabpanel][data-panel=id]
  Jump buttons: [data-jump=id]
--}}
<script>
  (function () {
    document.querySelectorAll('[data-admin-tabs]').forEach(function (root) {
      var tabs = Array.prototype.slice.call(root.querySelectorAll('[role="tab"]'));
      var panels = Array.prototype.slice.call(root.querySelectorAll('[role="tabpanel"]'));
      if (!tabs.length) return;

      var valid = {};
      tabs.forEach(function (t) {
        valid[t.getAttribute('data-tab')] = 1;
      });

      var defaultId = root.getAttribute('data-default') || tabs[0].getAttribute('data-tab');
      var errTab = root.getAttribute('data-err-tab') || '';
      var okMap = {};
      try {
        okMap = JSON.parse(root.getAttribute('data-ok-map') || '{}');
      } catch (e) {}

      function activate(id, pushHash) {
        if (!valid[id]) id = defaultId;
        tabs.forEach(function (tab) {
          var on = tab.getAttribute('data-tab') === id;
          tab.setAttribute('aria-selected', on ? 'true' : 'false');
          tab.tabIndex = on ? 0 : -1;
        });
        panels.forEach(function (panel) {
          var on = panel.getAttribute('data-panel') === id;
          panel.hidden = !on;
          panel.classList.toggle('hidden', !on);
          if (on) {
            panel.classList.remove('admin-panel');
            void panel.offsetWidth;
            panel.classList.add('admin-panel');
          }
        });
        if (pushHash !== false) {
          var url = new URL(window.location.href);
          url.hash = id === defaultId ? '' : id;
          history.replaceState(null, '', url.pathname + url.search + url.hash);
        }
      }

      function resolveInitial() {
        var params = new URLSearchParams(window.location.search);
        var tab = params.get('tab');
        if (tab && valid[tab]) return tab;
        var ok = params.get('ok');
        if (ok && okMap[ok]) return okMap[ok];
        if (params.get('err') && errTab && valid[errTab]) return errTab;
        var hash = (window.location.hash || '').replace(/^#/, '');
        if (hash && valid[hash]) return hash;
        return defaultId;
      }

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function (e) {
          e.preventDefault();
          activate(tab.getAttribute('data-tab'), true);
        });
        tab.addEventListener('keydown', function (e) {
          var i = tabs.indexOf(tab);
          var next = -1;
          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (i + 1) % tabs.length;
          if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (i - 1 + tabs.length) % tabs.length;
          if (e.key === 'Home') next = 0;
          if (e.key === 'End') next = tabs.length - 1;
          if (next < 0) return;
          e.preventDefault();
          tabs[next].focus();
          activate(tabs[next].getAttribute('data-tab'), true);
        });
      });

      document.querySelectorAll('[data-jump]').forEach(function (btn) {
        if (btn.__adminJumpBound) return;
        btn.__adminJumpBound = true;
        btn.addEventListener('click', function () {
          var id = btn.getAttribute('data-jump');
          var targetRoot = btn.closest('[data-admin-tabs]') || root;
          if (targetRoot !== root) return;
          activate(id, true);
        });
      });

      if (root.tagName === 'FORM') {
        root.addEventListener('submit', function () {
          panels.forEach(function (panel) {
            panel.hidden = false;
            panel.classList.remove('hidden');
          });
        });
      }

      activate(resolveInitial(), false);
    });
  })();
</script>
