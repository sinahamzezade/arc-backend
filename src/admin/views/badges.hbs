<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}} · Arc Admin</title>
    {{> layout}}
  </head>
  <body class="bg-mist text-moss font-sans antialiased">
    <div class="shell min-h-screen">
      {{> shell-sidebar}}
      <main class="relative flex-1 min-w-0 overflow-x-hidden">
        <div
          class="pointer-events-none absolute -right-20 top-8 h-64 w-64 rounded-full bg-leaf/70 blur-3xl"
          aria-hidden="true"
        ></div>
        <div
          class="pointer-events-none absolute left-1/3 top-72 h-48 w-48 rounded-full bg-clay/12 blur-3xl"
          aria-hidden="true"
        ></div>

        <div class="relative px-5 pb-20 pt-6 md:px-10 lg:px-12">
          {{#if flashOk}}
            <p class="mb-5 rounded-2xl bg-leaf px-4 py-3 text-sm font-medium text-moss" role="status">{{flashOk}}</p>
          {{/if}}
          {{#if flashErr}}
            <p class="mb-5 rounded-2xl bg-[#fde8e6] px-4 py-3 text-sm font-medium text-coral" role="alert">{{flashErr}}</p>
          {{/if}}

          <section class="relative mb-10 md:mb-12">
            <div
              class="relative overflow-hidden rounded-blob bg-gradient-to-br from-moss via-[#243f36] to-[#314f44] px-7 py-9 text-mist shadow-soft md:w-[82%] md:px-10 md:py-11"
            >
              <div class="absolute -left-8 bottom-0 h-36 w-36 rounded-full bg-leaf/20 blur-2xl" aria-hidden="true"></div>
              <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-leaf/80">Catalog</p>
              <h1 class="font-display max-w-[10ch] text-4xl font-semibold leading-[1.05] tracking-tight md:text-5xl lg:text-6xl">
                Badges
              </h1>
              <p class="mt-4 max-w-md text-sm text-mist/60">
                Unlock criteria, rarity, optional rewards. Draft while testing — activate when keys match the guide.
              </p>
              <div class="mt-6 flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center gap-2 rounded-full bg-leaf/90 px-3 py-1 text-xs font-semibold tabular-nums text-moss">
                  <i class="fa-solid fa-medal" aria-hidden="true"></i>
                  {{count}} definition{{#unless countSingular}}s{{/unless}}
                </span>
              </div>
            </div>

            <aside
              class="relative z-10 mt-4 rounded-blob border border-[#d5ddd7] bg-foam/95 p-5 shadow-lift backdrop-blur md:absolute md:-bottom-6 md:right-0 md:mt-0 md:w-[260px]"
            >
              <div class="mb-2 flex items-center gap-2">
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-leaf text-moss">
                  <i class="fa-solid fa-book-open" aria-hidden="true"></i>
                </span>
                <h2 class="font-display text-lg font-semibold">Quick nav</h2>
              </div>
              <p class="mb-4 text-sm leading-relaxed text-sage">
                Browse catalog, spawn a definition, or open the criteria cheat sheet.
              </p>
              <div class="flex flex-col gap-2">
                <button
                  type="button"
                  class="flex w-full items-center justify-center gap-2 rounded-full bg-moss px-4 py-2.5 text-sm font-semibold text-mist transition hover:brightness-110"
                  data-jump="create"
                >
                  <i class="fa-solid fa-plus" aria-hidden="true"></i>
                  New badge
                </button>
                <button
                  type="button"
                  class="flex w-full items-center justify-center gap-2 rounded-full border border-leaf bg-leaf/40 px-4 py-2.5 text-sm font-semibold text-moss transition hover:bg-leaf"
                  data-jump="guide"
                >
                  <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                  Open guide
                </button>
              </div>
            </aside>
          </section>

          <div
            class="admin-tabs md:w-[94%] md:max-w-5xl"
            data-admin-tabs
            data-default="catalog"
            data-err-tab="create"
          >
            <div class="mb-6 flex gap-0 overflow-x-auto" role="tablist" aria-label="Badges sections">
              <button type="button" role="tab" id="tab-catalog" aria-controls="panel-catalog" aria-selected="true" data-tab="catalog" class="shrink-0">
                <i class="fa-solid fa-list mr-1.5 text-xs opacity-70" aria-hidden="true"></i>
                Catalog
              </button>
              <button type="button" role="tab" id="tab-create" aria-controls="panel-create" aria-selected="false" data-tab="create" class="shrink-0">
                <i class="fa-solid fa-plus mr-1.5 text-xs opacity-70" aria-hidden="true"></i>
                Create
              </button>
              <button type="button" role="tab" id="tab-guide" aria-controls="panel-guide" aria-selected="false" data-tab="guide" class="shrink-0">
                <i class="fa-solid fa-compass mr-1.5 text-xs opacity-70" aria-hidden="true"></i>
                Guide
              </button>
            </div>

            {{!-- Catalog --}}
            <div id="panel-catalog" role="tabpanel" aria-labelledby="tab-catalog" data-panel="catalog" class="admin-panel">
              {{#if hasRows}}
                <div class="overflow-hidden rounded-blob bg-foam shadow-lift ring-1 ring-[#d5ddd7]">
                  <div class="overflow-x-auto">
                    <table class="admin-table">
                      <thead>
                        <tr>
                          <th></th>
                          <th>Code</th>
                          <th>Name</th>
                          <th>Category</th>
                          <th>Rarity</th>
                          <th>Criteria</th>
                          <th>Status</th>
                        </tr>
                      </thead>
                      <tbody>
                        {{#each rows}}
                          <tr>
                            <td>
                              {{#if iconThumbUrl}}
                                <img
                                  src="{{iconThumbUrl}}"
                                  alt=""
                                  width="32"
                                  height="32"
                                  class="h-8 w-8 rounded-lg border border-[#d5ddd7] object-cover"
                                />
                              {{else}}
                                <span class="text-sage">—</span>
                              {{/if}}
                            </td>
                            <td>
                              <a class="font-mono text-[13px] font-medium text-moss underline-offset-2 hover:underline" href="/admin/badges/{{id}}">{{code}}</a>
                            </td>
                            <td class="font-medium">{{name}}</td>
                            <td class="font-mono text-[12px] text-sage">{{category}}</td>
                            <td>{{rarity}}</td>
                            <td class="font-mono text-[12px] text-sage">{{criteriaType}}</td>
                            <td>
                              {{#if isActiveStatus}}
                                <span class="inline-flex items-center gap-1.5 rounded-full bg-leaf px-2.5 py-0.5 text-[11px] font-semibold text-moss">
                                  <i class="fa-solid fa-circle-check text-[10px]" aria-hidden="true"></i>
                                  {{status}}
                                </span>
                              {{else}}
                                <span class="inline-flex items-center gap-1.5 rounded-full bg-mist px-2.5 py-0.5 text-[11px] font-semibold text-sage">
                                  {{status}}
                                </span>
                              {{/if}}
                            </td>
                          </tr>
                        {{/each}}
                      </tbody>
                    </table>
                  </div>
                </div>
              {{else}}
                <div class="rounded-blob bg-foam px-6 py-14 text-center shadow-lift ring-1 ring-[#d5ddd7]">
                  <span class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-leaf text-moss">
                    <i class="fa-solid fa-medal" aria-hidden="true"></i>
                  </span>
                  <p class="font-display text-xl font-semibold">No badges yet</p>
                  <p class="mt-2 text-sm text-sage">Create one from the Create tab, or skim Guide for shapes.</p>
                  <button
                    type="button"
                    class="mt-5 inline-flex items-center gap-2 rounded-full bg-moss px-5 py-2.5 text-sm font-semibold text-mist transition hover:brightness-110"
                    data-jump="create"
                  >
                    <i class="fa-solid fa-plus" aria-hidden="true"></i>
                    Create first badge
                  </button>
                </div>
              {{/if}}
            </div>

            {{!-- Create --}}
            <div id="panel-create" role="tabpanel" aria-labelledby="tab-create" data-panel="create" class="admin-panel hidden" hidden>
              <div class="mb-5 md:ml-2 md:max-w-xl">
                <h2 class="font-display text-2xl font-semibold">Add badge</h2>
                <p class="mt-1 text-sm text-sage">
                  Prefills a counter example. Adjust JSON to match criteria type — see Guide.
                </p>
              </div>

              <form method="post" action="/admin/badges" class="space-y-6 md:ml-2">
                <div class="rounded-blob bg-foam p-5 shadow-lift ring-1 ring-[#d5ddd7]">
                  <div class="mb-4 flex items-center gap-2">
                    <span class="flex h-8 w-8 items-center justify-center rounded-full bg-leaf text-moss">
                      <i class="fa-solid fa-tag" aria-hidden="true"></i>
                    </span>
                    <h3 class="font-display text-lg font-semibold">Identity</h3>
                  </div>
                  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div class="admin-field">
                      <label for="code">Code</label>
                      <input id="code" name="code" type="text" placeholder="lesson-starter-plus" required />
                    </div>
                    <div class="admin-field">
                      <label for="name">Name</label>
                      <input id="name" name="name" type="text" placeholder="Lesson Starter+" required />
                    </div>
                    <div class="admin-field sm:col-span-2">
                      <label for="description">Description</label>
                      <textarea id="description" name="description" rows="2" placeholder="What the user did to earn this"></textarea>
                    </div>
                    <div class="admin-field">
                      <label for="iconAssetKey">Icon asset key</label>
                      <input id="iconAssetKey" name="iconAssetKey" type="text" placeholder="first-step (optional)" />
                    </div>
                    <div class="admin-field">
                      <label for="sortOrder">Sort order</label>
                      <input id="sortOrder" name="sortOrder" type="number" value="100" />
                    </div>
                  </div>
                </div>

                <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
                  <div class="rounded-blob bg-foam p-5 shadow-lift ring-1 ring-[#d5ddd7]">
                    <div class="mb-4 flex items-center gap-2">
                      <span class="flex h-8 w-8 items-center justify-center rounded-full bg-leaf text-moss">
                        <i class="fa-solid fa-sliders" aria-hidden="true"></i>
                      </span>
                      <h3 class="font-display text-lg font-semibold">Classification</h3>
                    </div>
                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                      <div class="admin-field">
                        <label for="category">Category</label>
                        <select id="category" name="category">
                          {{#each categories}}
                            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                          {{/each}}
                        </select>
                      </div>
                      <div class="admin-field">
                        <label for="rarity">Rarity</label>
                        <select id="rarity" name="rarity">
                          {{#each rarities}}
                            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                          {{/each}}
                        </select>
                      </div>
                      <div class="admin-field">
                        <label for="status">Status</label>
                        <select id="status" name="status">
                          {{#each statuses}}
                            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                          {{/each}}
                        </select>
                      </div>
                      <div class="admin-field">
                        <label for="criteriaType">Criteria type</label>
                        <select id="criteriaType" name="criteriaType">
                          {{#each criteriaTypes}}
                            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                          {{/each}}
                        </select>
                      </div>
                    </div>
                    <label class="mt-4 flex cursor-pointer items-center gap-3 rounded-2xl bg-mist/70 px-4 py-3 text-sm">
                      <input id="isHidden" name="isHidden" type="checkbox" value="1" class="h-4 w-4 accent-[#5b7c6e]" />
                      <span>
                        <span class="font-semibold text-moss">Hidden from catalog</span>
                        <span class="mt-0.5 block text-xs text-sage">Still unlocks; not shown in browse.</span>
                      </span>
                    </label>
                  </div>

                  <div class="rounded-blob bg-foam p-5 shadow-lift ring-1 ring-[#d5ddd7]">
                    <div class="mb-4 flex items-center gap-2">
                      <span class="flex h-8 w-8 items-center justify-center rounded-full bg-[#f3e0d6] text-clay">
                        <i class="fa-solid fa-code" aria-hidden="true"></i>
                      </span>
                      <h3 class="font-display text-lg font-semibold">Rules JSON</h3>
                    </div>
                    <div class="space-y-4">
                      <div class="admin-field">
                        <label for="criteriaJson">Criteria JSON</label>
                        <textarea id="criteriaJson" name="criteriaJson" rows="5" required>{"counterKey":"lessons_completed","target":10}</textarea>
                        <p class="mt-1.5 text-xs text-sage">
                          Keys must match live counters/events. <code class="rounded bg-leaf/60 px-1">composite</code> never unlocks yet.
                        </p>
                      </div>
                      <div class="admin-field">
                        <label for="rewardJson">Reward JSON</label>
                        <textarea id="rewardJson" name="rewardJson" rows="3">{"coins":25}</textarea>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="flex flex-wrap items-center gap-3">
                  {{> ui-button label="Create badge" icon="fa-solid fa-plus" }}
                  <button
                    type="button"
                    class="text-sm font-semibold text-sage transition hover:text-moss"
                    data-jump="guide"
                  >
                    Need the cheat sheet?
                  </button>
                </div>
              </form>
            </div>

            {{!-- Guide --}}
            <div id="panel-guide" role="tabpanel" aria-labelledby="tab-guide" data-panel="guide" class="admin-panel hidden" hidden>
              <div class="mb-6 grid grid-cols-1 gap-6 lg:grid-cols-12">
                <div class="lg:col-span-5 lg:pt-2">
                  <h2 class="font-display text-2xl font-semibold">How to add a badge</h2>
                  <p class="mt-2 text-sm leading-relaxed text-sage">
                    Badge unlocks when user progress hits the criteria. Fill Create → set
                    <strong>status = active</strong> → reuse a <strong>known counter/event key</strong>
                    (unknown keys never unlock without a code change).
                  </p>
                  <ol class="mt-5 space-y-3 text-sm text-moss">
                    <li class="flex gap-3">
                      <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-leaf text-xs font-bold">1</span>
                      <span><strong>Code</strong> — unique slug, e.g. <code class="rounded bg-leaf/60 px-1">ten-lessons</code> (lowercase, <code class="rounded bg-leaf/60 px-1">-</code>/<code class="rounded bg-leaf/60 px-1">_</code> ok)</span>
                    </li>
                    <li class="flex gap-3">
                      <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-leaf text-xs font-bold">2</span>
                      <span><strong>Name / description</strong> — shown in the app catalog</span>
                    </li>
                    <li class="flex gap-3">
                      <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-leaf text-xs font-bold">3</span>
                      <span><strong>Criteria type</strong> — pick one, then match JSON shape below</span>
                    </li>
                    <li class="flex gap-3">
                      <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-leaf text-xs font-bold">4</span>
                      <span><strong>Reward JSON</strong> — optional, e.g. <code class="rounded bg-leaf/60 px-1">{"coins":25}</code> or <code class="rounded bg-leaf/60 px-1">{"gems":5}</code></span>
                    </li>
                    <li class="flex gap-3">
                      <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-leaf text-xs font-bold">5</span>
                      <span><strong>Image</strong> — optional here; after create, open the badge → upload PNG/WebP</span>
                    </li>
                    <li class="flex gap-3">
                      <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-leaf text-xs font-bold">6</span>
                      <span>Save → unlocks automatically next time matching domain event runs</span>
                    </li>
                  </ol>
                </div>

                <div class="lg:col-span-7">
                  <div class="overflow-hidden rounded-blob bg-foam shadow-lift ring-1 ring-[#d5ddd7] lg:-mt-2">
                    <div class="border-b border-[#e4ebe6] bg-[#eef3ef] px-5 py-3">
                      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-sage">Worked example — complete 10 lessons</p>
                    </div>
                    <div class="grid grid-cols-2 gap-3 p-5 sm:grid-cols-4">
                      <div>
                        <p class="text-[10px] font-semibold uppercase tracking-wider text-sage">Code</p>
                        <p class="mt-1 font-mono text-sm font-medium">ten-lessons</p>
                      </div>
                      <div>
                        <p class="text-[10px] font-semibold uppercase tracking-wider text-sage">Name</p>
                        <p class="mt-1 text-sm font-medium">Ten Lessons</p>
                      </div>
                      <div>
                        <p class="text-[10px] font-semibold uppercase tracking-wider text-sage">Type</p>
                        <p class="mt-1 font-mono text-sm">counter</p>
                      </div>
                      <div>
                        <p class="text-[10px] font-semibold uppercase tracking-wider text-sage">Status</p>
                        <p class="mt-1 font-mono text-sm">active</p>
                      </div>
                    </div>
                    <div class="space-y-3 border-t border-[#e4ebe6] px-5 pb-5 pt-4">
                      <div>
                        <p class="text-[10px] font-semibold uppercase tracking-wider text-sage">Criteria</p>
                        <pre class="mt-1 overflow-x-auto rounded-2xl bg-mist/80 px-3 py-2 font-mono text-[12px] text-moss">{"counterKey":"lessons_completed","target":10}</pre>
                      </div>
                      <div>
                        <p class="text-[10px] font-semibold uppercase tracking-wider text-sage">Reward</p>
                        <pre class="mt-1 overflow-x-auto rounded-2xl bg-mist/80 px-3 py-2 font-mono text-[12px] text-moss">{"coins":40}</pre>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="overflow-hidden rounded-blob bg-foam shadow-lift ring-1 ring-[#d5ddd7]">
                <div class="border-b border-[#e4ebe6] bg-[#eef3ef] px-5 py-3">
                  <p class="text-xs font-semibold uppercase tracking-[0.14em] text-sage">Criteria cheat sheet</p>
                </div>
                <div class="overflow-x-auto">
                  <table class="admin-table">
                    <thead>
                      <tr>
                        <th>Type</th>
                        <th>Criteria JSON</th>
                        <th>Live keys</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td class="align-top font-mono text-[12px] font-semibold">counter</td>
                        <td class="align-top font-mono text-[11px] text-sage">{"counterKey":"lessons_completed","target":5}</td>
                        <td class="align-top text-xs leading-relaxed text-sage">lessons_completed, weeks_completed, quizzes_passed, perfect_quizzes, practices_completed, deep_lessons, challenges_passed, battle_wins, study_sessions_qualified</td>
                      </tr>
                      <tr>
                        <td class="align-top font-mono text-[12px] font-semibold">distinct_set</td>
                        <td class="align-top font-mono text-[11px] text-sage">{"setKey":"lesson_formats","setTarget":5}</td>
                        <td class="align-top text-xs leading-relaxed text-sage">lesson_formats, study_partners</td>
                      </tr>
                      <tr>
                        <td class="align-top font-mono text-[12px] font-semibold">consecutive</td>
                        <td class="align-top font-mono text-[11px] text-sage">{"consecutiveKey":"weekly_streak","minConsecutive":2}</td>
                        <td class="align-top text-xs leading-relaxed text-sage">weekly_streak</td>
                      </tr>
                      <tr>
                        <td class="align-top font-mono text-[12px] font-semibold">event_once</td>
                        <td class="align-top font-mono text-[11px] text-sage">{"eventType":"roadmap.generated.v1"}</td>
                        <td class="align-top text-xs leading-relaxed text-sage">roadmap.generated.v1, weekly_plan.activated.v1, comeback.completed.v1</td>
                      </tr>
                      <tr>
                        <td class="align-top font-mono text-[12px] font-semibold">referral_milestone</td>
                        <td class="align-top font-mono text-[11px] text-sage">{"referralQualified":5}</td>
                        <td class="align-top text-xs leading-relaxed text-sage">referrals_qualified</td>
                      </tr>
                      <tr>
                        <td class="align-top font-mono text-[12px] font-semibold">composite</td>
                        <td class="align-top text-xs text-sage" colspan="2">Deferred — will not unlock yet.</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>

              <p class="mt-4 text-sm text-sage md:ml-1">
                Tip: leave status <span class="font-mono text-moss">draft</span> while testing fields, then switch to
                <span class="font-mono text-moss">active</span> when ready. Prefer <strong>active</strong> only when
                counter/event key is in the cheat sheet above.
              </p>
            </div>
          </div>
        </div>
      </main>
    </div>

    {{> admin-tabs-script}}
  </body>
</html>
