<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}} · Arc Admin</title>
    {{> layout}}
  </head>
  <body class="bg-mist text-moss font-sans antialiased">
    <div class="shell min-h-screen">
      {{> shell-sidebar}}
      <main class="relative flex-1 min-w-0 overflow-x-hidden">
        <div
          class="pointer-events-none absolute -right-24 top-10 h-72 w-72 rounded-full bg-leaf/60 blur-3xl"
          aria-hidden="true"
        ></div>
        <div
          class="pointer-events-none absolute left-1/4 top-80 h-48 w-48 rounded-full bg-clay/12 blur-3xl"
          aria-hidden="true"
        ></div>

        <div class="relative px-5 pb-24 pt-6 md:px-10 lg:px-12">
          <p class="mb-5 text-sm text-sage">
            <a href="/admin/skill-graph" class="transition hover:text-moss">Skill graph</a>
            <span class="mx-2 opacity-40">/</span>
            <a href="/admin/skill-graph/stacks/{{stack.id}}" class="transition hover:text-moss">{{stack.slug}}</a>
            <span class="mx-2 opacity-40">/</span>
            <a href="/admin/skill-graph/skills/{{skill.id}}" class="transition hover:text-moss">{{skill.slug}}</a>
            <span class="mx-2 opacity-40">/</span>
            <span class="font-mono text-[13px]">{{lesson.slug}}</span>
          </p>

          {{#if flashOk}}
            <p class="mb-5 rounded-2xl bg-leaf px-4 py-3 text-sm font-medium text-moss" role="status">{{flashOk}}</p>
          {{/if}}
          {{#if flashErr}}
            <p class="mb-5 rounded-2xl bg-[#fde8e6] px-4 py-3 text-sm font-medium text-coral" role="alert">{{flashErr}}</p>
          {{/if}}

          <section class="relative mb-10 md:mb-12">
            <div
              class="relative overflow-hidden rounded-blob bg-gradient-to-br from-moss via-[#243f36] to-[#314f44] px-7 py-9 text-mist shadow-soft md:w-[85%] md:px-10 md:py-11"
            >
              <div class="absolute -right-6 top-4 h-28 w-28 rotate-12 rounded-[1.5rem] border border-white/10" aria-hidden="true"></div>
              <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-leaf/80">Lesson template</p>
              <h1 class="font-display max-w-[18ch] text-4xl font-semibold leading-[1.05] tracking-tight text-balance md:text-5xl">
                {{lesson.title}}
              </h1>
              <p class="mt-3 font-mono text-sm text-mist/50">{{lesson.slug}}</p>
              <div class="mt-6 flex flex-wrap gap-2">
                <span class="inline-flex items-center gap-2 rounded-full bg-clay/90 px-3 py-1 text-xs font-semibold text-foam">
                  <i class="fa-solid fa-shapes" aria-hidden="true"></i>
                  {{lesson.lessonType}}
                </span>
                <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold tabular-nums text-mist/85">
                  <i class="fa-solid fa-clock" aria-hidden="true"></i>
                  {{lesson.estimatedMinutes}} min
                </span>
                <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold tabular-nums text-mist/85">
                  <i class="fa-solid fa-bolt" aria-hidden="true"></i>
                  {{lesson.xpReward}} XP
                </span>
                {{#if lesson.isActive}}
                  <span class="inline-flex items-center gap-2 rounded-full bg-leaf/90 px-3 py-1 text-xs font-semibold text-moss">
                    <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                    Active
                  </span>
                {{else}}
                  <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-mist/80">
                    Off
                  </span>
                {{/if}}
              </div>
            </div>
          </section>

          <form
            method="post"
            action="/admin/skill-graph/lessons/{{lesson.id}}"
            class="admin-tabs md:w-[94%] md:max-w-5xl"
            data-admin-tabs
            data-default="basics"
            data-err-tab="basics"
          >
            <div class="mb-6 flex gap-0 overflow-x-auto" role="tablist" aria-label="Lesson editor sections">
              <button type="button" role="tab" id="tab-basics" aria-controls="panel-basics" aria-selected="true" data-tab="basics" class="shrink-0">
                <i class="fa-solid fa-id-card mr-1.5 text-xs opacity-70" aria-hidden="true"></i>
                Basics
              </button>
              <button type="button" role="tab" id="tab-outline" aria-controls="panel-outline" aria-selected="false" data-tab="outline" class="shrink-0">
                <i class="fa-solid fa-code mr-1.5 text-xs opacity-70" aria-hidden="true"></i>
                Outline
              </button>
            </div>

            <div id="panel-basics" role="tabpanel" aria-labelledby="tab-basics" data-panel="basics" class="admin-panel">
              <div class="mb-4 md:ml-2 md:max-w-lg">
                <h2 class="font-display text-2xl font-semibold">Basics</h2>
                <p class="mt-1 text-sm text-sage">Type, timing, XP, mission label, style tags, and active flag.</p>
              </div>
              <div class="rounded-blob bg-foam p-5 shadow-lift ring-1 ring-[#d5ddd7] md:ml-2 md:max-w-2xl">
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                  <div class="admin-field">
                    <label for="title">Title</label>
                    <input id="title" name="title" type="text" value="{{lesson.title}}" required />
                  </div>
                  <div class="admin-field">
                    <label for="lessonType">Type</label>
                    <select id="lessonType" name="lessonType">
                      {{#each lessonTypes}}
                        <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                      {{/each}}
                    </select>
                  </div>
                  <div class="admin-field">
                    <label for="estimatedMinutes">Minutes</label>
                    <input id="estimatedMinutes" name="estimatedMinutes" type="number" value="{{lesson.estimatedMinutes}}" />
                  </div>
                  <div class="admin-field">
                    <label for="xpReward">XP</label>
                    <input id="xpReward" name="xpReward" type="number" value="{{lesson.xpReward}}" />
                  </div>
                  <div class="admin-field">
                    <label for="orderHint">Order</label>
                    <input id="orderHint" name="orderHint" type="number" value="{{lesson.orderHint}}" />
                  </div>
                  <div class="admin-field">
                    <label for="missionNameTemplate">Mission name</label>
                    <input id="missionNameTemplate" name="missionNameTemplate" type="text" value="{{lesson.missionNameTemplate}}" />
                  </div>
                  <div class="admin-field sm:col-span-2">
                    <label for="learningStyleTags">Style tags (comma)</label>
                    <input id="learningStyleTags" name="learningStyleTags" type="text" value="{{lesson.learningStyleTagsCsv}}" />
                  </div>
                </div>
                <label class="mt-4 flex cursor-pointer items-center gap-3 rounded-2xl bg-mist/70 px-4 py-3 text-sm">
                  <input id="isActive" name="isActive" type="checkbox" value="1" class="h-4 w-4 accent-[#5b7c6e]" {{#if lesson.isActive}}checked{{/if}} />
                  <span>
                    <span class="font-semibold text-moss">Active</span>
                    <span class="mt-0.5 block text-xs text-sage">Inactive lessons are skipped by planners.</span>
                  </span>
                </label>
              </div>
            </div>

            <div id="panel-outline" role="tabpanel" aria-labelledby="tab-outline" data-panel="outline" class="admin-panel hidden" hidden>
              <div class="mb-4 md:ml-2 md:max-w-xl">
                <h2 class="font-display text-2xl font-semibold">Content outline</h2>
                <p class="mt-1 text-sm text-sage">Play outline JSON used when generating or serving lesson body.</p>
              </div>
              <div class="rounded-blob bg-foam p-5 shadow-lift ring-1 ring-[#d5ddd7] md:ml-2">
                <div class="admin-field">
                  <label for="contentOutlineJson">Content outline (JSON)</label>
                  <textarea id="contentOutlineJson" name="contentOutlineJson" rows="18" class="min-h-[320px]">{{lesson.contentOutlineJson}}</textarea>
                </div>
              </div>
            </div>

            <div class="sticky bottom-4 z-20 mt-8 flex flex-wrap items-center gap-3 rounded-blob border border-[#d5ddd7] bg-foam/95 px-5 py-4 shadow-lift backdrop-blur md:ml-2">
              {{> ui-button label="Save lesson" icon="fa-solid fa-floppy-disk" }}
              <a href="/admin/skill-graph/skills/{{skill.id}}" class="text-sm font-semibold text-sage transition hover:text-moss">Back to skill</a>
            </div>
          </form>

          <section class="mt-12 md:ml-2 md:max-w-xl">
            <div class="mb-3 flex items-baseline justify-between gap-3">
              <h2 class="font-display text-xl font-semibold text-coral">Danger</h2>
              <span class="text-xs font-medium uppercase tracking-[0.14em] text-sage">Irreversible</span>
            </div>
            <div class="rounded-blob border border-[#f0c9c5] bg-[#fdf6f5] p-5">
              <p class="mb-4 text-sm leading-relaxed text-sage">
                Deletes this lesson template from the skill graph.
              </p>
              <form
                method="post"
                action="/admin/skill-graph/lessons/{{lesson.id}}/delete"
                onsubmit="return confirm('Delete this lesson?');"
              >
                {{> ui-button label="Delete lesson" variant="danger" icon="fa-solid fa-trash" }}
              </form>
            </div>
          </section>
        </div>
      </main>
    </div>
    {{> admin-tabs-script}}
  </body>
</html>
