<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}} · Arc Admin</title>
    {{> layout}}
    <style>
      .health-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 12px;
        padding: 16px;
      }
      .stat {
        background: #eef3ef;
        border-radius: 1rem;
        padding: 14px 16px;
      }
      .stat .k {
        font-size: 0.7rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #5b7c6e;
        margin: 0 0 6px;
      }
      .stat .v {
        font-size: 1.15rem;
        font-weight: 600;
        margin: 0;
        word-break: break-all;
      }
      .stat .v.mono { font-size: 0.95rem; }
      .panel-pad { padding: 16px; }
      .panel + .panel { margin-top: 18px; }
      pre.result {
        margin: 0;
        padding: 14px 16px;
        overflow: auto;
        max-height: 420px;
        font-size: 0.78rem;
        line-height: 1.45;
        background: #1a2e28;
        color: #d7e4dc;
      }
      .phase-list {
        margin: 0;
        padding: 0 16px 16px;
        list-style: none;
      }
      .phase-list li {
        padding: 8px 0;
        border-bottom: 1px solid #e4ebe6;
        font-size: 0.9rem;
        display: flex;
        justify-content: space-between;
        gap: 12px;
      }
      .phase-list li:last-child { border-bottom: none; }
    </style>
  </head>
  <body>
    <div class="shell">
      {{> shell-sidebar}}
      <main class="main">
        <div class="page-head">
          <h1>Roadmap Engine</h1>
          <p class="sub">Health check + dry-run plan against Python planner</p>
        </div>

        {{#if flashOk}}<p class="flash flash-ok">{{flashOk}}</p>{{/if}}
        {{#if flashErr}}<p class="flash flash-err">{{flashErr}}</p>{{/if}}

        <h2 class="section-title">Health</h2>
        <div class="panel">
          <div class="health-grid">
            <div class="stat">
              <p class="k">Reachable</p>
              <p class="v">
                {{#if health.reachable}}
                  <span class="badge badge-ok">Yes</span>
                {{else}}
                  <span class="badge badge-off">No</span>
                {{/if}}
              </p>
            </div>
            <div class="stat">
              <p class="k">Status</p>
              <p class="v">{{health.status}}</p>
            </div>
            <div class="stat">
              <p class="k">Engine version</p>
              <p class="v mono">
                {{#if health.engineVersion}}{{health.engineVersion}}{{else}}—{{/if}}
                <span class="muted" style="font-size:0.75rem;font-weight:500">
                  / nest {{health.nestExpectedVersion}}
                </span>
              </p>
            </div>
            <div class="stat">
              <p class="k">Latency</p>
              <p class="v mono">
                {{#if health.latencyMs}}{{health.latencyMs}} ms{{else}}—{{/if}}
              </p>
            </div>
            <div class="stat">
              <p class="k">Mode</p>
              <p class="v mono">{{config.mode}}</p>
            </div>
            <div class="stat">
              <p class="k">Redis queue</p>
              <p class="v">
                {{#if config.redisConfigured}}
                  <span class="badge badge-ok">Configured</span>
                {{else}}
                  <span class="badge badge-off">In-process</span>
                {{/if}}
              </p>
            </div>
          </div>
          <dl class="detail-grid">
            <dt>Engine URL</dt>
            <dd class="mono">{{config.baseUrl}}</dd>
            <dt>Timeout</dt>
            <dd class="mono">{{config.timeoutMs}} ms</dd>
            {{#if health.error}}
              <dt>Error</dt>
              <dd class="mono" style="color:#b42318">{{health.error}}</dd>
            {{/if}}
          </dl>
          <div class="form-actions">
            <form method="get" action="/admin/roadmap-engine" style="margin:0">
              <button type="submit" class="secondary">Refresh health</button>
            </form>
          </div>
        </div>

        <h2 class="section-title">Dry-run plan</h2>
        <div class="panel">
          <form method="post" action="/admin/roadmap-engine/test">
            <div class="form-grid">
              <div style="grid-column: 1 / -1">
                <label for="goalId">Active goal</label>
                <select id="goalId" name="goalId" required>
                  <option value="">Select a goal…</option>
                  {{#each goals}}
                    <option value="{{id}}" {{#if selected}}selected{{/if}}>
                      {{label}}
                    </option>
                  {{/each}}
                </select>
              </div>
              <div style="grid-column: 1 / -1">
                <label for="goalIdManual">Or paste goal UUID</label>
                <input
                  id="goalIdManual"
                  name="goalIdManual"
                  type="text"
                  placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                  value="{{goalIdManual}}"
                />
              </div>
            </div>
            <p class="muted panel-pad" style="padding-top:0;margin:0">
              Calls snapshot builder + <code>POST /v1/plan</code>. Does
              <strong>not</strong> write a roadmap row.
            </p>
            <div class="form-actions">
              <button type="submit">Run dry-run</button>
            </div>
          </form>
        </div>

        {{#if hasResult}}
          <h2 class="section-title">Result</h2>
          <div class="panel">
            <div class="health-grid">
              <div class="stat">
                <p class="k">Plan OK</p>
                <p class="v">
                  {{#if result.ok}}
                    <span class="badge badge-ok">Yes</span>
                  {{else}}
                    <span class="badge badge-off">No</span>
                  {{/if}}
                </p>
              </div>
              {{#if result.summary}}
                <div class="stat">
                  <p class="k">Recipe</p>
                  <p class="v mono">{{result.summary.recipe}}</p>
                </div>
                <div class="stat">
                  <p class="k">Phases</p>
                  <p class="v mono">{{result.summary.phaseCount}}</p>
                </div>
                <div class="stat">
                  <p class="k">Lessons</p>
                  <p class="v mono">{{result.summary.lessonCount}}</p>
                </div>
                <div class="stat">
                  <p class="k">Est. weeks</p>
                  <p class="v mono">
                    {{#if result.summary.estimatedWeeks}}{{result.summary.estimatedWeeks}}{{else}}—{{/if}}
                  </p>
                </div>
                <div class="stat">
                  <p class="k">Seed</p>
                  <p class="v mono">{{result.summary.seed}}</p>
                </div>
              {{/if}}
            </div>
            {{#if result.error}}
              <p class="flash flash-err" style="margin:0 16px 12px">{{result.error}}</p>
            {{/if}}
            {{#if hasPhaseTitles}}
              <ul class="phase-list">
                {{#each phaseTitles}}
                  <li>
                    <span>{{title}} <span class="muted">({{weekType}})</span></span>
                    <span class="mono muted">{{milestones}} milestones</span>
                  </li>
                {{/each}}
              </ul>
            {{/if}}
            {{#if result.rawJson}}
              <pre class="result">{{result.rawJson}}</pre>
            {{/if}}
          </div>
        {{/if}}
      </main>
    </div>
  </body>
</html>
