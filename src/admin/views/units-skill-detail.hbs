<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}} · Arc Admin</title>
    {{> layout}}
  </head>
  <body class="bg-mist text-moss font-sans antialiased">
    <div class="shell min-h-screen">
      {{> shell-sidebar}}
      <main class="relative flex-1 min-w-0 overflow-x-hidden">
        <div class="relative px-5 pb-20 pt-6 md:px-10 lg:px-12">
          {{#if flashOk}}
            <p class="mb-5 rounded-2xl bg-leaf px-4 py-3 text-sm font-medium text-moss" role="status">{{flashOk}}</p>
          {{/if}}
          {{#if flashErr}}
            <p class="mb-5 rounded-2xl bg-[#fde8e6] px-4 py-3 text-sm font-medium text-coral" role="alert">{{flashErr}}</p>
          {{/if}}

          <nav class="mb-6 text-sm text-sage">
            <a href="/admin/units" class="hover:text-fern">Units</a>
            <span class="mx-2">/</span>
            <a href="/admin/units?tab=skills" class="hover:text-fern">Skills</a>
            <span class="mx-2">/</span>
            <span class="font-mono text-[12px]">{{skill.id}}</span>
          </nav>

          <section class="relative mb-10">
            <div class="relative overflow-hidden rounded-blob bg-gradient-to-br from-moss via-[#243f36] to-[#314f44] px-7 py-9 text-mist shadow-soft md:w-[82%] md:px-10 md:py-11">
              <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-leaf/80">Skill · level {{skill.level}}</p>
              <h1 class="font-display max-w-[20ch] text-3xl font-semibold leading-[1.05] tracking-tight md:text-4xl">
                {{skill.title}}
              </h1>
              <div class="mt-6 flex flex-wrap gap-2">
                <span class="inline-flex items-center gap-2 rounded-full bg-leaf/90 px-3 py-1 font-mono text-[11px] font-semibold text-moss">{{skill.id}}</span>
                {{#if skill.isActive}}
                  <span class="inline-flex items-center gap-2 rounded-full bg-mist/15 px-3 py-1 text-xs font-semibold text-mist">Active</span>
                {{else}}
                  <span class="inline-flex items-center gap-2 rounded-full bg-[#fde8e6] px-3 py-1 text-xs font-semibold text-coral">Inactive</span>
                {{/if}}
              </div>
            </div>
          </section>

          <div class="md:max-w-4xl space-y-6">
            <form method="post" action="/admin/units/skills/{{skill.id}}" class="rounded-blob border border-[#d5ddd7] bg-foam/95 p-6 shadow-lift space-y-5">
              <div class="grid gap-4 md:grid-cols-2">
                <label class="block text-sm font-semibold">
                  Title
                  <input name="title" value="{{skill.title}}" required class="mt-2 w-full rounded-2xl border border-[#d5ddd7] bg-mist/40 px-4 py-2.5 text-sm font-normal" />
                </label>
                <label class="block text-sm font-semibold">
                  Level
                  <input name="level" value="{{skill.level}}" type="number" min="1" class="mt-2 w-full rounded-2xl border border-[#d5ddd7] bg-mist/40 px-4 py-2.5 text-sm font-normal tabular-nums" />
                </label>
              </div>

              <label class="block text-sm font-semibold">
                Prerequisites
                <input name="prerequisites" value="{{skill.prerequisitesCsv}}" class="mt-2 w-full rounded-2xl border border-[#d5ddd7] bg-mist/40 px-4 py-2.5 font-mono text-xs" placeholder="stack:skill-a, stack:skill-b" />
                <span class="mt-1 block text-xs font-normal text-sage">Comma-separated skill ids. Cycles are rejected on save.</span>
              </label>

              <div class="flex flex-wrap items-center gap-4 pt-2">
                <label class="flex items-center gap-2 text-sm">
                  <input type="checkbox" name="isActive" value="true" {{#if skill.isActive}}checked{{/if}} />
                  Active (visible to the roadmap pipeline)
                </label>
                <button type="submit" class="ml-auto rounded-full bg-moss px-6 py-2.5 text-sm font-semibold text-mist">
                  Save skill
                </button>
              </div>
            </form>

            <div class="rounded-blob border border-[#d5ddd7] bg-foam/95 p-6 shadow-lift">
              <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-sage">Units teaching this skill</h2>
              {{#if hasTaughtBy}}
                <table class="w-full text-left text-sm">
                  <thead class="border-b border-[#d5ddd7] text-xs uppercase tracking-wide text-sage">
                    <tr>
                      <th class="py-2 pr-4">Id</th>
                      <th class="py-2 pr-4">Title</th>
                      <th class="py-2 pr-4">Type</th>
                      <th class="py-2">Active</th>
                    </tr>
                  </thead>
                  <tbody>
                    {{#each taughtBy}}
                      <tr class="border-b border-[#e8eee9] last:border-0">
                        <td class="py-2.5 pr-4 font-mono text-[12px]">
                          <a href="/admin/units/{{id}}" class="underline decoration-leaf underline-offset-2 hover:text-fern">{{id}}</a>
                        </td>
                        <td class="py-2.5 pr-4 font-medium">{{title}}</td>
                        <td class="py-2.5 pr-4">{{lessonType}}</td>
                        <td class="py-2.5">{{#if isActive}}Yes{{else}}No{{/if}}</td>
                      </tr>
                    {{/each}}
                  </tbody>
                </table>
              {{else}}
                <p class="text-sm text-sage">No units teach this skill yet.</p>
              {{/if}}
            </div>

            <div class="rounded-blob border border-[#d5ddd7] bg-foam/95 p-6 shadow-lift">
              <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-sage">Other skills</h2>
              <div class="flex flex-wrap gap-2">
                {{#each otherSkills}}
                  <a href="/admin/units/skills/{{id}}" class="rounded-full border border-moss/20 px-3 py-1 font-mono text-[11px] transition hover:bg-leaf/60" title="{{title}} (level {{level}})">{{id}}</a>
                {{else}}
                  <p class="text-sm text-sage">No other skills.</p>
                {{/each}}
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>
