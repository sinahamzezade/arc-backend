<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}} · Arlo Admin</title>
    {{> layout}}
  </head>
  <body class="bg-mist text-moss font-sans antialiased">
    <div class="shell min-h-screen">
      {{> shell-sidebar}}
      <main class="relative flex-1 min-w-0 overflow-x-hidden">
        <div
          class="pointer-events-none absolute -right-20 top-8 h-64 w-64 rounded-full bg-leaf/70 blur-3xl"
          aria-hidden="true"
        ></div>
        <div
          class="pointer-events-none absolute left-1/3 top-72 h-48 w-48 rounded-full bg-clay/12 blur-3xl"
          aria-hidden="true"
        ></div>

        <div class="relative px-5 pb-20 pt-6 md:px-10 lg:px-12">
          {{#if flashOk}}
            <p class="mb-5 rounded-2xl bg-leaf px-4 py-3 text-sm font-medium text-moss" role="status">{{flashOk}}</p>
          {{/if}}
          {{#if flashErr}}
            <p class="mb-5 rounded-2xl bg-[#fde8e6] px-4 py-3 text-sm font-medium text-coral" role="alert">{{flashErr}}</p>
          {{/if}}

          <section class="relative mb-10 md:mb-12">
            <div
              class="relative overflow-hidden rounded-blob bg-gradient-to-br from-moss via-[#243f36] to-[#314f44] px-7 py-9 text-mist shadow-soft md:w-[82%] md:px-10 md:py-11"
            >
              <div class="absolute -left-8 bottom-0 h-36 w-36 rounded-full bg-leaf/20 blur-2xl" aria-hidden="true"></div>
              <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-leaf/80">Career catalog</p>
              <h1 class="font-display max-w-[10ch] text-4xl font-semibold leading-[1.05] tracking-tight md:text-5xl lg:text-6xl">
                Roles
              </h1>
              <p class="mt-4 max-w-md text-sm text-mist/60">
                Career roles that drive the questionnaire goal step — sync active ones when ready.
              </p>
              <div class="mt-6 flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center gap-2 rounded-full bg-leaf/90 px-3 py-1 text-xs font-semibold tabular-nums text-moss">
                  <i class="fa-solid fa-briefcase" aria-hidden="true"></i>
                  {{count}} career role{{#unless countSingular}}s{{/unless}}
                </span>
              </div>
            </div>

            <aside
              class="relative z-10 mt-4 rounded-blob border border-[#d5ddd7] bg-foam/95 p-5 shadow-lift backdrop-blur md:absolute md:-bottom-6 md:right-0 md:mt-0 md:w-[280px]"
            >
              <div class="mb-2 flex items-center gap-2">
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-leaf text-moss">
                  <i class="fa-solid fa-bolt" aria-hidden="true"></i>
                </span>
                <h2 class="font-display text-lg font-semibold">Actions</h2>
              </div>
              <p class="mb-4 text-sm leading-relaxed text-sage">
                Create a role, then push active catalog entries into questionnaire Q1.
              </p>
              <div class="flex flex-col gap-2">
                <button
                  type="button"
                  class="flex w-full items-center justify-center gap-2 rounded-full bg-moss px-4 py-2.5 text-sm font-semibold text-mist transition hover:brightness-110"
                  data-jump="create"
                >
                  <i class="fa-solid fa-plus" aria-hidden="true"></i>
                  New role
                </button>
                <form method="post" action="/admin/roles/sync" class="m-0">
                  {{> ui-button
                    label="Sync → questionnaire"
                    variant="secondary"
                    icon="fa-solid fa-arrows-rotate"
                    class="w-full justify-center"
                  }}
                </form>
              </div>
            </aside>
          </section>

          <div class="admin-tabs md:w-[94%] md:max-w-5xl" data-admin-tabs data-default="catalog" data-err-tab="create">
            <div class="mb-6 flex gap-0 overflow-x-auto" role="tablist" aria-label="Roles sections">
              <button type="button" role="tab" id="tab-catalog" aria-controls="panel-catalog" aria-selected="true" data-tab="catalog" class="shrink-0">
                <i class="fa-solid fa-list mr-1.5 text-xs opacity-70" aria-hidden="true"></i>
                Catalog
              </button>
              <button type="button" role="tab" id="tab-create" aria-controls="panel-create" aria-selected="false" data-tab="create" class="shrink-0">
                <i class="fa-solid fa-plus mr-1.5 text-xs opacity-70" aria-hidden="true"></i>
                Create
              </button>
            </div>

            <div id="panel-catalog" role="tabpanel" aria-labelledby="tab-catalog" data-panel="catalog" class="admin-panel">
              {{#if hasRows}}
                <div class="overflow-hidden rounded-blob bg-foam shadow-lift ring-1 ring-[#d5ddd7]">
                  <div class="overflow-x-auto">
                    <table class="admin-table">
                      <thead>
                        <tr>
                          <th>Title</th>
                          <th>Slug</th>
                          <th>Category</th>
                          <th>Status</th>
                          <th></th>
                        </tr>
                      </thead>
                      <tbody>
                        {{#each rows}}
                          <tr>
                            <td class="font-medium">{{title}}</td>
                            <td class="font-mono text-[13px] text-sage">{{slug}}</td>
                            <td class="text-sage">{{category}}</td>
                            <td>
                              {{#if isActive}}
                                <span class="inline-flex items-center gap-1.5 rounded-full bg-leaf px-2.5 py-0.5 text-[11px] font-semibold text-moss">
                                  <i class="fa-solid fa-circle-check text-[10px]" aria-hidden="true"></i>
                                  Active
                                </span>
                              {{else}}
                                <span class="inline-flex items-center gap-1.5 rounded-full bg-mist px-2.5 py-0.5 text-[11px] font-semibold text-sage">
                                  Off
                                </span>
                              {{/if}}
                            </td>
                            <td>
                              {{#if isActive}}
                                <form method="post" action="/admin/roles/{{id}}/deactivate" class="m-0">
                                  {{> ui-button label="Deactivate" variant="secondary" size="sm" }}
                                </form>
                              {{else}}
                                <form method="post" action="/admin/roles/{{id}}/activate" class="m-0">
                                  {{> ui-button label="Activate" variant="secondary" size="sm" }}
                                </form>
                              {{/if}}
                            </td>
                          </tr>
                        {{/each}}
                      </tbody>
                    </table>
                  </div>
                </div>
              {{else}}
                <div class="rounded-blob bg-foam px-6 py-14 text-center shadow-lift ring-1 ring-[#d5ddd7]">
                  <span class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-leaf text-moss">
                    <i class="fa-solid fa-briefcase" aria-hidden="true"></i>
                  </span>
                  <p class="font-display text-xl font-semibold">No career roles yet</p>
                  <p class="mt-2 text-sm text-sage">Create one or sync from skill-graph seed.</p>
                  <button
                    type="button"
                    class="mt-5 inline-flex items-center gap-2 rounded-full bg-moss px-5 py-2.5 text-sm font-semibold text-mist transition hover:brightness-110"
                    data-jump="create"
                  >
                    <i class="fa-solid fa-plus" aria-hidden="true"></i>
                    Create first role
                  </button>
                </div>
              {{/if}}
            </div>

            <div id="panel-create" role="tabpanel" aria-labelledby="tab-create" data-panel="create" class="admin-panel hidden" hidden>
              <div class="mb-5 md:ml-2 md:max-w-xl">
                <h2 class="font-display text-2xl font-semibold">Add role</h2>
                <p class="mt-1 text-sm text-sage">
                  Optionally push straight onto the questionnaire goal step.
                </p>
              </div>

              <form method="post" action="/admin/roles" class="space-y-6 md:ml-2">
                <div class="rounded-blob bg-foam p-5 shadow-lift ring-1 ring-[#d5ddd7]">
                  <div class="mb-4 flex items-center gap-2">
                    <span class="flex h-8 w-8 items-center justify-center rounded-full bg-leaf text-moss">
                      <i class="fa-solid fa-id-badge" aria-hidden="true"></i>
                    </span>
                    <h3 class="font-display text-lg font-semibold">Role details</h3>
                  </div>
                  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div class="admin-field">
                      <label for="title">Title</label>
                      <input id="title" name="title" type="text" placeholder="Data Engineer" required />
                    </div>
                    <div class="admin-field">
                      <label for="slug">Slug (optional)</label>
                      <input id="slug" name="slug" type="text" placeholder="data-engineer" />
                    </div>
                    <div class="admin-field">
                      <label for="category">Category</label>
                      <input id="category" name="category" type="text" value="career" />
                    </div>
                    <div class="admin-field">
                      {{> ui-icon-select}}
                    </div>
                    <div class="admin-field sm:col-span-2">
                      <label for="description">Description</label>
                      <textarea id="description" name="description"></textarea>
                    </div>
                  </div>
                  <label class="mt-4 flex cursor-pointer items-center gap-3 rounded-2xl bg-mist/70 px-4 py-3 text-sm">
                    <input id="addToQuestionnaire" name="addToQuestionnaire" type="checkbox" value="1" checked class="h-4 w-4 accent-[#5b7c6e]" />
                    <span>
                      <span class="font-semibold text-moss">Add to questionnaire goal step</span>
                      <span class="mt-0.5 block text-xs text-sage">Creates a Q1 option on the active version.</span>
                    </span>
                  </label>
                </div>

                <div class="flex flex-wrap items-center gap-3">
                  {{> ui-button label="Create role" icon="fa-solid fa-plus" }}
                </div>
              </form>
            </div>
          </div>
        </div>
      </main>
    </div>
    {{> admin-tabs-script}}
  </body>
</html>
