DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=arc
DB_PASSWORD=arc
DB_NAME=arc
DB_SYNC=true
DB_POOL_MAX=20
DB_POOL_IDLE_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000

PORT=9000
NODE_ENV=development

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_TTL=30d

COOKIE_DOMAIN=
# Comma-separated allowed origins for HTTP + Socket.IO (add each app origin)
CORS_ORIGIN=http://localhost:3000
# Optional Socket.IO handshake path (must match frontend NEXT_PUBLIC_WS_PATH). Default /socket.io
# WS_PATH=/socket.io
# Public web origin for referral share links (no trailing slash)
PUBLIC_APP_URL=http://localhost:3000

ADMIN_SESSION_SECRET=dev-admin-session-secret-change-me
# Boot auto-seed (set false on prod; use `npm run seed:admin` instead)
ADMIN_SEED=true
ADMIN_SEED_EMAIL=ops.ctrl.9f2a@arc.internal
ADMIN_SEED_PASSWORD='K7#mQ9$vL2!pR4xW8nT'
# Server one-shot: npm run seed:admin
#   or: npm run seed:admin -- --email you@example.com --password 'StrongPass1!'
# Docker: docker compose exec app npm run seed:admin

GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Use onboarding@resend.dev until your domain is verified at resend.com/domains
EMAIL_FROM=Arlo <onboarding@resend.dev>
EMAIL_PROVIDER_API_KEY=

# Roadmap Generator AI enrich (optional — soft-fail if unset)
OPENAI_API_KEY=
ROADMAP_GENERATOR_PROMPT_VERSION=roadmap_generator_v1
OPENAI_ROADMAP_MODEL=gpt-4o-mini

# LLM multi-provider (OpenAI-compatible). Catalog: src/common/llm/llm.providers.ts
# Add model = one line in that file. Runtime routes model id → provider API.
#
# Preferred provider (seeds admin defaults): groq | cerebras | openrouter | openai | gemini
LLM_PROVIDER=cerebras
#
# Per-provider API keys (only need keys for providers you use):
CEREBRAS_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter — https://openrouter.ai/docs/quickstart (optional)
OPENROUTER_API_KEY=
# OpenAI / Gemini (optional)
GEMINI_API_KEY=
# Legacy shared key (fallback if provider-specific unset)
LLM_API_KEY=
# Optional override for unknown model ids only (catalog models ignore this)
# LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_INTAKE_MODEL=gemma-4-31b
LLM_INTAKE_FALLBACK_MODELS=
# Roadmap / Arlo / Battle / Intake / Lesson models → Admin → Feature flags.
# Env only seeds first boot (llm_*_model flags).
LLM_HTTP_REFERER=http://localhost:3000
LLM_APP_TITLE=Arlo

# Intake: form vs conversational chat (user can override at intro)
INTAKE_DEFAULT_MODE=form
INTAKE_CHAT_ENABLED=true

# Lesson body personalization after materialize (default off; also Admin → Feature flags)
LESSON_BODY_AI_ENABLED=false
# Model → Admin → Feature flags (llm_lesson_body_model). Env only seeds first boot.

# Roadmap planner: llm (default, uses admin llm_roadmap_model) | python | legacy
ROADMAP_ENGINE_URL=http://localhost:8080
ROADMAP_ENGINE_VERSION=2
ROADMAP_ENGINE_MODE=llm
ROADMAP_GENERATION_TIMEOUT_MS=45000
ROADMAP_GENERATION_MAX_RETRIES=3
# Redis (BullMQ + presence). Leave unset for in-process jobs.
# Local: redis://localhost:6379
# Railway: add Redis plugin, set REDIS_URL to that service URL (NOT localhost)
REDIS_URL=redis://localhost:6379
JWT_USER_CACHE_TTL_SEC=60

# WebRTC STUN/TURN
# Local: coturn via docker-compose.dev.yml (localhost OK)
# Production: NEVER localhost. Railway HTTPS is NOT a TURN host.
#
# --- Option A (fastest): Open Relay staticauth (HMAC, 20GB/mo free) ---
# Docs: https://www.metered.ca/tools/openrelay/
# TURN_SHARED_SECRET=openrelayprojectsecret
# TURN_REALM=openrelay.metered.ca
# STUN_URLS=stun:stun.relay.metered.ca:80
# TURN_URLS=turn:staticauth.openrelay.metered.ca:80?transport=udp,turn:staticauth.openrelay.metered.ca:80?transport=tcp,turn:staticauth.openrelay.metered.ca:443?transport=tcp,turns:staticauth.openrelay.metered.ca:443?transport=tcp
#
# --- Option B: Metered dashboard API (geo ICE list) ---
# TURN_METERED_API_URL=https://YOUR_APP.metered.live/api/v1/turn/credentials
# TURN_METERED_API_KEY=your_api_key
#
# --- Option C: self-hosted coturn (coturn/turnserver.prod.conf) ---
TURN_SHARED_SECRET=dev-turn-shared-secret-change-me
TURN_REALM=arc.local
STUN_URLS=stun:localhost:3478
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
# Optional static creds (if provider gives username/password instead of HMAC):
# TURN_USERNAME=
# TURN_CREDENTIAL=
CACHE_DEFAULT_TTL_SEC=300
ROADMAP_CACHE_TTL_SEC=120
PROFILE_CACHE_TTL_SEC=60

# Admin uploads: Postgres bytea by default (survives redeploys). S3 off unless enabled.
S3_ENABLED=false
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# Questionnaire question copy via OpenAI (optional — soft-fail to seed copy)
QUESTIONNAIRE_AI_ENABLED=true
QUESTIONNAIRE_AI_PROMPT_VERSION=questionnaire_copy_v1
OPENAI_QUESTIONNAIRE_MODEL=gpt-4o-mini
# Set true once to wipe catalog + answers, then set false (AI regenerates on empty ai_enriched_at)
QUESTIONNAIRE_RESET_ON_BOOT=false

# Weekly Plan / Seal Week (doc 04)
WEEKS_LOCK_REWARD_XP=50
WEEKS_LOCK_REWARD_GEMS=8
WEEKS_SEAL_HOURS_RATIO=0.8
WEEKS_STREAK_RESET_ON_MISS=false
WEEKS_REPLAN_MAX_PER_WEEK=2
WEEKS_TZ_FALLBACK=UTC
